@{
    ViewData["Title"] = "Home Page";
}

<!-- NAV simulado -->
<div class="nav-sim"></div>

<!-- HOME -->
<div class="home">

    <!-- Contenido -->
    <div class="home-content">
        <div class="home-badge">
            <span class="dot"></span>
            Sistema DIF Puebla
        </div>

        <h1 class="home-titulo">
            <span class="texto-dark">¡Bienvenido al</span><br>
            <span class="texto-gradiente">Sistema de Recursos</span><br>
            <span class="texto-gradiente">Materiales</span>
        </h1>

        <p class="home-subtitulo">Departamento de Recursos Materiales</p>

        <div class="home-fecha">
            <span class="line-md--calendar"></span>
            Lunes, 16 de febrero 2026
        </div>

        <div class="home-acciones">
            <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="home-btn-primary">
                Nueva Requisición →
            </a>
            <a href="@Url.Action("TablaRequisiciones", "Requisicion")" class="home-btn-secondary">
                Ver Requisiciones
            </a>
        </div>

        <div class="home-stats">
            <div class="stat-card">
                <div class="stat-numero">-</div>
                <div class="stat-label">Requisiciones</div>
            </div>
            <div class="stat-card">
                <div class="stat-numero">-</div>
                <div class="stat-label">Pendientes</div>
            </div>
            <div class="stat-card">
                <div class="stat-numero">-</div>
                <div class="stat-label">Realizadas</div>
            </div>
        </div>
    </div>
</div>