                    <i class="fa-solid fa-paperclip" style="color:#fe6291;margin-right:6px;"></i>
                    Documentos adjuntos
                </p>
                <div id="consolidadaDocumentos" style="margin-bottom:16px;">
                    <p style="color:#888;font-size:12px;font-style:italic;">Sin documentos</p>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal" id="modalAtenderConsolidada" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-detalle-requisicion">
        <div class="modal-content modal-premium modal-premium-ancha">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium">Atender Consolidada</h5>
                    <p class="modal-subtitulo-premium" id="atenderConsolidadaSubtitulo">
                        Cargando...
                    </p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="px-4" style="margin-top:20px;">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Actividad:</label>
                            <select id="consActividadSelect" class="rosa-select-form">
                                <option value="">-- Selecciona actividad --</option>
                                @foreach (var act in Model.ListaActividades)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Fuente de Financiamiento:</label>
                            <select id="consFfSelect" class="rosa-select-form">
                                <option value="">-- Selecciona Fuente de Financiamiento --</option>
                                @foreach (var ff in Model.ListaFuentesFinanciamiento)
                                {
                                    <option value="@ff.Value">@ff.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Tipo de Programa:</label>
                            <select id="consTipoProgramaSelect" class="rosa-select-form">
                                <option value="">-- Selecciona el Tipo de Programa --</option>
                                <option value="1">Prioritario</option>
                                <option value="2">Adicional</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-body modal-body-premium">
                <div class="table-responsive-container">
                    <table class="tabla-requisiciones" id="tablaModalAtenderConsolidada">
                        <thead>
                            <tr>
                                <th>RequisiciÃ³n</th>
                                <th style="text-align:center">Partida</th>
                                <th style="text-align:center">Cantidad</th>
                                <th>Unidad</th>
                                <th>DescripciÃ³n</th>
                                <th>DescripciÃ³n Detallada</th>
                            </tr>
                        </thead>
                        <tbody id="atenderConsArticulosBody"></tbody>
                    </table>
                </div>

                <div id="consolidadaDocsExistentes" style="display:none;margin-bottom:16px;">
                    <p style="font-size:12px;font-weight:600;color:var(--slate-600);margin-bottom:6px;">
                        <i class="fa-solid fa-paperclip" style="color:#fe6291;margin-right:4px;"></i>
                        Documentos subidos
                    </p>
                    <div id="consolidadaDocsExistentesBody"></div>
                </div>

                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="formulario-input">
                            <label>Cotizaciones</label>
                            <div id="estadoProveedoresConsolidada" style="display:none; margin-bottom:10px; color:#15803d; font-size:13px; font-weight:600;">
                                Proveedores seleccionados correctamente
                            </div>
                            <button type="button" class="btn boton-rosa"
                                    onclick="abrirWizardCotizacionesConsolidada()">
                                <span id="textoBtnProveedoresCons">Seleccionar Proveedores</span>
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="formulario-input">
                            <label>Cuadro comparativo</label>
                            <button type="button" id="btnCuadroConsolidada"
                                    class="btn boton-rosa w-100 mb-2"
                                    onclick="descargarCuadroConsolidada()"
                                    title="Disponible cuando se hayan seleccionado los proveedores"
                                    disabled>
                                Descargar cuadro comparativo
                            </button>
                            <input type="file" id="inputCuadroConsolidada" class="input-file-rosa" />
                        </div>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="formulario-input">
                            <label>Documentos Anexos</label>
                            <input type="file" id="inputAnexosConsolidada" class="input-file-rosa" multiple />
                        </div>
                    </div>
                </div>
                <div class="formulario-input">
                    <label>Observaciones</label>
                    <textarea id="txtObsConsolidada" class="form-control" rows="3"
                              placeholder="Escriba las observaciones aquí..."></textarea>
                </div>

                <div style="margin-top:20px;text-align:right;">
                    <button type="button" class="btn boton-rosa"
                            onclick="enviarAtencionConsolidada()">
                        <i class="fa-solid fa-paper-plane"></i> Enviar
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

