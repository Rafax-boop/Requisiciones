@using Inventario.AplicacionWeb.Models.ViewModels
@model List<VMRequisicionMaestra>
@{
    ViewData["Title"] = "TablaRequisiciones";
}

<div class="tabla-requi-page">
    <div class="tabla-requi-header">
        <div>
            <h1 class="tabla-requi-titulo">Requisiciones</h1>
            <p class="tabla-requi-subtitulo">Gestión y seguimiento de requisiciones</p>
        </div>
        <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="boton-rosa">
            <i class="fa-solid fa-plus"></i> Nueva Requisición
        </a>
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>Buscar</label>
            <input type="text" placeholder="Buscar por folio, responsable..." />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly />
        </div>
        <div class="filtro-grupo">
            <label>Nº Requisición</label>
            <input type="text" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <div class="filtro-dropdown">
                <button type="button" class="filtro-dropdown-btn">
                    <span>Todos</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <ul class="filtro-dropdown-menu">
                    <li class="filtro-dropdown-item active">Todos</li>
                    <li class="filtro-dropdown-item">Departamento 1</li>
                    <li class="filtro-dropdown-item">Departamento 2</li>
                    <li class="filtro-dropdown-item">Departamento 3</li>
                    <li class="filtro-dropdown-item">Departamento 4</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="container-formulario tabla-container">
        <table class="tabla-requisiciones">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Fecha de emisión</th>
                    <th>Departamento</th>
                    <th>Responsable</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NumRequi</td>
                        <td>@item.FechaEmision</td>
                        <td>@item.Departamento</td>
                        <td>@item.Responsable</td>
                        <td>@item.Estatus</td>
                        <td>
                            <div class="acciones-grupo">
                                <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                                <button class="btn-accion btn-editar" title="Editar">
                                    <i class="fa-solid fa-pen"></i>
                                </button>
                                <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal" id="modalDetalle" tabindex="-1" aria-labelledby="detalleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="detalleLabel">Artículos de la Requisición</h5>
                    <p class="modal-subtitulo-premium">Detalle de partidas solicitadas</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body modal-body-premium">
                <table class="tabla-requisiciones" id="tablaModalDetalle">
                    <thead>
                        <tr>
                            <th>Nº Partida</th>
                            <th>ID Artículo</th>
                            <th>Cantidad</th>
                            <th>Unidad Medida</th>
                            <th>Descripción</th>
                            <th>Descripción Detallada</th>
                        </tr>
                    </thead>
                    <tbody id="tablaDetalle">
                        <!-- Se carga dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Panel de descripción detallada — fuera del modal para evitar clipping -->
<div id="desc-panel-modal" style="display:none;">
    <div class="desc-panel-modal-header">
        <span class="desc-panel-modal-titulo">Descripción detallada</span>
        <button type="button" class="desc-panel-modal-cerrar" onclick="cerrarDescPanelModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <textarea id="desc-textarea-modal" class="desc-textarea" readonly rows="5"></textarea>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.filtro-dropdown-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                this.closest('.filtro-dropdown').classList.toggle('open');
            });
        });

        document.querySelectorAll('.filtro-dropdown-item').forEach(item => {
            item.addEventListener('click', function () {
                const dropdown = this.closest('.filtro-dropdown');
                const btnText = dropdown.querySelector('.filtro-dropdown-btn span');

                dropdown.querySelectorAll('.filtro-dropdown-item').forEach(i => i.classList.remove('active'));
                this.classList.add('active');
                btnText.textContent = this.textContent;

                dropdown.classList.remove('open');
            });
        });

        document.addEventListener('click', function (e) {
            if (!e.target.closest('.filtro-dropdown')) {
                document.querySelectorAll('.filtro-dropdown').forEach(d => d.classList.remove('open'));
            }
        });

        flatpickr('#filtroFecha', {
            locale: 'es',
            dateFormat: 'd / M / Y',
            allowInput: false,
            disableMobile: true
        });

        const obtenerDetallesUrl = '@Url.Action("ObtenerDetalles", "Requisicion")';
        const verPdfUrl = '@Url.Action("VerParaPdf", "Requisicion")';

        function verPdf(id) {
            window.open(verPdfUrl + '/' + id, '_blank');
        }

        let _descPanelModalTrigger = null;

        function verDescDetalleModal(el) {
            const panel = document.getElementById('desc-panel-modal');
            const textarea = document.getElementById('desc-textarea-modal');

            textarea.value = el.dataset.full || '(Sin descripción detallada)';

            const rect = el.getBoundingClientRect();
            panel.style.top = (rect.bottom + 4) + 'px';
            panel.style.left = rect.left + 'px';
            panel.style.minWidth = Math.max(rect.width, 320) + 'px';
            panel.style.display = 'block';

            _descPanelModalTrigger = el;
            textarea.focus();
        }

        function cerrarDescPanelModal() {
            document.getElementById('desc-panel-modal').style.display = 'none';
            _descPanelModalTrigger = null;
        }

        $(document).on('mousedown', function (e) {
            if (!_descPanelModalTrigger) return;
            const panel = document.getElementById('desc-panel-modal');
            if (!_descPanelModalTrigger.contains(e.target) && !panel.contains(e.target)) {
                cerrarDescPanelModal();
            }
        });

        function verDetalle(idMaestro) {
            $.get(obtenerDetallesUrl, { idMaestro: idMaestro }, function (data) {
                let total = 0;
                let contenido = '';
                let articulos = data.articulos;

                if (articulos.length === 0) {
                    contenido = '<tr><td colspan="6" class="text-center">Sin artículos</td></tr>';
                } else {
                    articulos.forEach(item => {
                        const textoCompleto = item.descripcionDetallada || '';
                        const textoCorto = textoCompleto.length > 28
                            ? textoCompleto.substring(0, 28) + '…'
                            : (textoCompleto || 'Sin descripción...');
                        const tieneTexto = textoCompleto ? 'tiene-texto' : '';
                        const fullEscapado = textoCompleto.replace(/"/g, '&quot;');

                        contenido += `
                            <tr>
                                <td>${item.numPartida}</td>
                                <td>${item.idArticulo}</td>
                                <td>${item.cantidad}</td>
                                <td>${item.unidadMedida}</td>
                                <td>${item.descripcion}</td>
                                <td>
                                    <div class="desc-preview-modal" data-full="${fullEscapado}" onclick="verDescDetalleModal(this)">
                                        <span class="desc-texto-preview ${tieneTexto}">${textoCorto}</span>
                                        <i class="fa-solid fa-eye desc-icon"></i>
                                    </div>
                                </td>
                            </tr>`;
                    });
                }

                $('#tablaDetalle').html(contenido);

                // Mostrar modal
                $('#modalDetalle').modal('show');
            });
        }
    </script>
}