<div class="modal" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium">Gestionar requisición</h5>
                    <p class="modal-subtitulo-premium" id="modalAsignarSubtitulo">Selecciona una acción</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body modal-body-premium">

                <!-- PASO 1: Las 3 opciones -->
                <div id="pasoOpciones">
                    <p style="font-size:13px; color:var(--color-text-secondary, #888); margin:0 0 1rem;">
                        Selecciona una acción para esta requisición:
                    </p>
                    <div style="display:flex; flex-direction:column; gap:10px;">

                        <button type="button" onclick="mostrarPasoAsignar()"
                                style="display:flex; align-items:center; gap:12px; padding:12px 16px;
                                   border-radius:8px; border:1px solid #ddd; background:white;
                                   cursor:pointer; text-align:left; width:100%;">
                            <div style="width:32px; height:32px; border-radius:50%; background:#EBF5FB;
                                        display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="fa-solid fa-clipboard-user" style="color:#2980B9; font-size:14px;"></i>
                            </div>
                            <div>
                                <p style="font-size:14px; font-weight:500; margin:0;">Asignar a responsable</p>
                                <p style="font-size:12px; color:#888; margin:2px 0 0;">Turnar a alguien de tu equipo</p>
                            </div>
                        </button>

                        <button type="button" id="btnOpcionAlmacen" onclick="mostrarPasoAlmacen()"
                                style="display:flex; align-items:center; gap:12px; padding:12px 16px;
                                   border-radius:8px; border:1px solid #ddd; background:white;
                                   cursor:pointer; text-align:left; width:100%;">
                            <div style="width:32px; height:32px; border-radius:50%; background:#EAFAF1;
                                        display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="fa-solid fa-arrow-right" style="color:#27AE60; font-size:14px;"></i>
                            </div>
                            <div>
                                <p style="font-size:14px; font-weight:500; margin:0;">Enviar a almacén</p>
                                <p style="font-size:12px; color:#888; margin:2px 0 0;">Pasar directamente al área de almacén</p>
                            </div>
                        </button>

                        <button type="button" onclick="mostrarPasoModificar()"
                                style="display:flex; align-items:center; gap:12px; padding:12px 16px;
                                       border-radius:8px; border:1px solid #fde68a; background:white;
                                       cursor:pointer; text-align:left; width:100%;">
                            <div style="width:32px; height:32px; border-radius:50%; background:#FFFBEB;
                                        display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="fa-solid fa-rotate-left" style="color:#D97706; font-size:14px;"></i>
                            </div>
                            <div>
                                <p style="font-size:14px; font-weight:500; margin:0; color:#D97706;">Solicitar modificación</p>
                                <p style="font-size:12px; color:#888; margin:2px 0 0;">Regresar al usuario con observaciones</p>
                            </div>
                        </button>

                        <button type="button" onclick="mostrarPasoRechazar()"
                                style="display:flex; align-items:center; gap:12px; padding:12px 16px;
                                   border-radius:8px; border:1px solid #f5c6c6; background:white;
                                   cursor:pointer; text-align:left; width:100%;">
                            <div style="width:32px; height:32px; border-radius:50%; background:#FDEDEC;
                                        display:flex; align-items:center; justify-content:center; flex-shrink:0;">
                                <i class="fa-solid fa-circle-xmark" style="color:#E74C3C; font-size:14px;"></i>
                            </div>
                            <div>
                                <p style="font-size:14px; font-weight:500; margin:0; color:#E74C3C;">Rechazar requisición</p>
                                <p style="font-size:12px; color:#888; margin:2px 0 0;">Devolver con observaciones</p>
                            </div>
                        </button>

                    </div>
                </div>

                <!-- PASO 2A: Asignar -->
                <div id="pasoAsignar" style="display:none;">
                    <button type="button" onclick="volverOpciones()"
                            style="display:flex; align-items:center; gap:6px; background:none; border:none;
                               cursor:pointer; color:#888; font-size:13px; padding:0; margin-bottom:1rem;">
                        <i class="fa-solid fa-arrow-left" style="font-size:11px;"></i> Volver
                    </button>
                    <div class="formulario-input">
                        <label>Responsable:</label>
                        <select id="selectUsuarioAsignar" class="form-select select2">
                            <option value="">-- Seleccionar responsable --</option>
                        </select>
                    </div>
                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:1rem;">
                        <button type="button" class="btn boton-gris" onclick="volverOpciones()">Cancelar</button>
                        <button type="button" class="btn boton-rosa" onclick="confirmarAsignacion()">Confirmar asignación</button>
                    </div>
                </div>

                <!-- PASO 2B: Enviar a almacén -->
                <div id="pasoAlmacen" style="display:none;">
                    <button type="button" onclick="volverOpciones()"
                            style="display:flex; align-items:center; gap:6px; background:none; border:none;
                               cursor:pointer; color:#888; font-size:13px; padding:0; margin-bottom:1rem;">
                        <i class="fa-solid fa-arrow-left" style="font-size:11px;"></i> Volver
                    </button>
                    <p style="font-size:14px; font-weight:500; margin:0 0 6px;">¿Enviar a almacén?</p>
                    <p style="font-size:13px; color:#888; margin:0 0 1.5rem;">
                        La requisición será turnada directamente al área de almacén sin asignación previa.
                    </p>
                    <div style="display:flex; justify-content:flex-end; gap:8px;">
                        <button type="button" class="btn boton-gris" onclick="volverOpciones()">Cancelar</button>
                        <button type="button" class="btn boton-rosa" onclick="confirmarEnvioAlmacen()">
                            Sí, enviar a almacén
                        </button>
                    </div>
                </div>

                <!-- PASO 2C: Modificar -->
                <div id="pasoModificar" style="display:none;">
                    <button type="button" onclick="volverOpciones()"
                            style="display:flex; align-items:center; gap:6px; background:none; border:none;
                                   cursor:pointer; color:#888; font-size:13px; padding:0; margin-bottom:1rem;">
                        <i class="fa-solid fa-arrow-left" style="font-size:11px;"></i> Volver
                    </button>
                    <div class="formulario-input">
                        <label>Observaciones para modificación:</label>
                        <textarea id="txtObservacionModificacion" class="form-control" rows="3"
                                  placeholder="Indica qué debe corregir el usuario..."></textarea>
                    </div>
                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:1rem;">
                        <button type="button" class="btn boton-gris" onclick="volverOpciones()">Cancelar</button>
                        <button type="button" class="btn"
                                style="background:#D97706; color:white; border:none;"
                                onclick="confirmarModificacion()">
                            <i class="fa-solid fa-rotate-left"></i> Confirmar modificación
                        </button>
                    </div>
                </div>

                <!-- PASO 2D: Rechazar -->
                <div id="pasoRechazar" style="display:none;">
                    <button type="button" onclick="volverOpciones()"
                            style="display:flex; align-items:center; gap:6px; background:none; border:none;
                               cursor:pointer; color:#888; font-size:13px; padding:0; margin-bottom:1rem;">
                        <i class="fa-solid fa-arrow-left" style="font-size:11px;"></i> Volver
                    </button>
                    <div class="formulario-input">
                        <label>Motivo del rechazo:</label>
                        <textarea id="txtMotivoRechazo" class="form-control" rows="3"
                                  placeholder="Escribe el motivo del rechazo..."></textarea>
                    </div>
                    <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:1rem;">
                        <button type="button" class="btn boton-gris" onclick="volverOpciones()">Cancelar</button>
                        <button type="button" class="btn btn-danger" onclick="confirmarRechazo()">
                            Confirmar rechazo
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
