@using Inventario.AplicacionWeb.Models.ViewModels
@model List<VMRequisicionMaestra>
@{
    ViewData["Title"] = "TablaRequisiciones";
}

@section Styles {
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="tabla-requi-page" data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")"
     data-url-ver-pdf="@Url.Action("VerParaPdf", "Requisicion")"
     data-url-usuarios-materiales="@Url.Action("ObtenerUsuariosMateriales", "Requisicion")"
     data-url-asignar=" @Url.Action("AsignarRequisicion", "Requisicion")"
     data-url-atender="@Url.Action("Atender", "Requisicion")"
     data-url-buscar-cogs="@Url.Action("BuscarCogs", "Requisicion")">
    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Requisiciones</h1>
            <p class="tabla-requi-subtitulo">Gestión y seguimiento de requisiciones</p>
        </div>
        @if (User.IsInRole("1"))
        {
            @if (DateTime.Now.Day <= 5 || int.Parse(User.FindFirst("IdDepartamento")?.Value ?? "0") == 29)
            {
                <a href="#" class="boton-rosa" data-bs-toggle="modal" data-bs-target="#modalNuevaRequisicion">
                    <i class="fa-solid fa-plus"></i> Nueva Requisición
                </a>
            }
            else
            {
                <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="boton-rosa">
                    <i class="fa-solid fa-plus"></i> Nueva Requisición
                </a>
            }
        }
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>Nº Requisición</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly style="width:100%;" />
                <button type="button" id="btnLimpiarFecha" onclick="limpiarFecha()"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
    </div>

    <div class="container-formulario tabla-container">
        <table class="tabla-requisiciones">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Folio</th>
                    <th>Fecha de emisión</th>
                    <th>Departamento</th>
                    <th>Responsable</th>
                    <th style="text-align:center">Items</th>
                    <th>Estado</th>
                    @if (User.IsInRole("4"))
                    {
                        <th>Asignado</th>
                    }
                    @if (User.IsInRole("3") || User.IsInRole("4"))
                    {
                        <th>Estatus</th>
                    }
                    <th style="text-align:center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var idxReq = 0;
                }
                @foreach (var item in Model)
                {
                    idxReq++;
                    <tr>
                        <td style="text-align:center">@idxReq</td>
                        <td>@item.NumRequi</td>
                        <td>@item.FechaEmision</td>
                        <td>@item.Departamento</td>
                        <td>@item.Responsable</td>
                        <td style="text-align:center">@item.CantidadPartidas</td>
                        <td>@item.Estatus</td>
                        
                        @if (User.IsInRole("4"))
                        {
                            <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                        }

                        @if (User.IsInRole("3") || User.IsInRole("4"))
                        {
                            <td>
                                @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                {
                                    var claseColor = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                    <span class="badge-semaforo-premium @claseColor">
                                        <i class="fa-solid fa-circle"></i> 
                                        <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                }
                            </td>
                        }
                        <td>
                            <div class="acciones-grupo" style="justify-content:center">
                                @if (item.Estatus == "REQUISICION AUTORIZADA" || !User.IsInRole("3"))
                                {
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i> </button>
                                    }
                                    @if (item.Estatus == "REQUISICION MODIFICACIÓN" && User.IsInRole("1"))
                                    {
                                        <a href="@Url.Action("EditarRequisicion", "Requisicion", new { id = item.IdRequi })"
                                               class="btn-accion btn-editar" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                    @if (User.IsInRole("4") && item.Estatus == "REQUISICION CAPTURADA")
                                    {
                                        <button class="btn-accion" title="Asignar Requisición"
                                                onclick="abrirModalAsignar(@item.IdRequi)">
                                            <i class="fa-solid fa-clipboard-user"></i>
                                        </button>
                                    }
                                    @if (User.IsInRole("3") && item.Estatus == "REQUISICION EN PROCESO")
                                    {
                                        <button class="btn-accion" title="Atender" onclick="atenderRequisicion(@item.IdRequi)">
                                            <i class="fa-solid fa-hand-holding"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>

    @if (DateTime.Now.Day <= 5 || int.Parse(User.FindFirst("IdDepartamento")?.Value ?? "0") == 29)
    {
        <div class="modal" id="modalNuevaRequisicion" tabindex="-1" aria-labelledby="modalNuevaRequisicionLabel"
             aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-nueva-requisicion">
                <div class="modal-content modal-premium">
                    <div class="modal-header modal-header-premium">
                        <div>
                            <h5 class="modal-title modal-titulo-premium" id="modalNuevaRequisicionLabel">Nueva Requisición</h5>
                            <p class="modal-subtitulo-premium">Seleccione el tipo de requisición para continuar</p>
                        </div>
                        <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <div class="modal-body modal-body-premium modal-body-nueva-requisicion">
                        <div class="btn-stack">
                            <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="btn btn-primary-nueva">
                                <span class="btn-icon-nueva"><i class="fa-solid fa-clipboard-list"></i></span>
                                <span class="btn-text">Requisición General<small>Bienes y suministros varios</small></span>
                            </a>
                            <a href="@Url.Action("FormularioRequisiciones", "Requisicion", new { tipo = "mensual" })"
                                   class="btn btn-secondary-nueva">
                                <span class="btn-icon-nueva"><i class="fa-solid fa-box"></i></span>
                                <span class="btn-text">Requisición de Materiales Mensual<small>Abastecimiento recurrente del
                                    mes</small></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="modal" id="modalDetalle" tabindex="-1" aria-labelledby="detalleLabel" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-centered">
                <div class="modal-content modal-premium">
                    <div class="modal-header modal-header-premium">
                        <div>
                            <h5 class="modal-title modal-titulo-premium" id="detalleLabel">Artículos de la Requisición</h5>
                            <p class="modal-subtitulo-premium">Detalle de partidas solicitadas</p>
                        </div>
                        <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <div class="modal-body modal-body-premium">
                        <table class="tabla-requisiciones" id="tablaModalDetalle">
                            <thead>
                                <tr>
                                    <th>Nº Partida</th>
                                    <th>ID Artículo</th>
                                    <th>Cantidad</th>
                                    <th>Unidad Medida</th>
                                    <th>Descripción</th>
                                    <th>Descripción Detallada</th>
                                    <th>COG Editable</th>
                                </tr>
                            </thead>
                            <tbody id="tablaDetalle">
                                <!-- Se carga dinámicamente -->
                            </tbody>
                        </table>
                        <div id="seccionAtender" style="display:none; margin-top:20px;">

                            <div class="formulario-input">
                                <label>Observaciones</label>
                                <textarea id="txtObservaciones" class="form-control" rows="4"
                                          placeholder="Escriba las observaciones aquí..."></textarea>
                            </div>

                            <div style="margin-top:15px;">
                                <label class="atender-opcion">
                                    <input type="checkbox" id="chkRequiereModificacion" />
                                    <div class="bullet">
                                        <div class="line zero"></div>
                                        <div class="line one"></div>
                                        <div class="line two"></div>
                                        <div class="line three"></div>
                                        <div class="line four"></div>
                                        <div class="line five"></div>
                                        <div class="line six"></div>
                                        <div class="line seven"></div>
                                    </div>
                                    <span>Requiere modificación</span>
                                </label>
                            </div>

                            <div style="margin-top:20px; text-align:right;">
                                <button type="button" class="btn boton-rosa" onclick="enviarAtencion()">
                                    Enviar
                                </button>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal" id="modalAsignar" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content modal-premium">
                    <div class="modal-header modal-header-premium">
                        <div>
                            <h5 class="modal-title modal-titulo-premium">Asignar Requisición</h5>
                            <p class="modal-subtitulo-premium">Seleccione el responsable de atender esta solicitud</p>
                        </div>
                        <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>
                    <div class="modal-body modal-body-premium">
                        <div class="formulario-input">
                            <label>Responsable:</label>
                            <select id="selectUsuarioAsignar" class="form-select select2">
                                <option value="">-- Seleccionar responsable --</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn boton-gris" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn boton-rosa" onclick="confirmarAsignacion()">Asignar</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Panel de descripción detallada — fuera del modal para evitar clipping -->
        <div id="desc-panel-modal" style="display:none;">
            <div class="desc-panel-modal-header">
                <span class="desc-panel-modal-titulo">Descripción detallada</span>
                <button type="button" class="desc-panel-modal-cerrar" onclick="cerrarDescPanelModal()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <textarea id="desc-textarea-modal" class="desc-textarea" readonly rows="5"></textarea>
        </div>

        @section Scripts {
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
            <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
            <script src="~/js/requisicion/tabla-requisiciones.js" asp-append-version="true"></script>
        }