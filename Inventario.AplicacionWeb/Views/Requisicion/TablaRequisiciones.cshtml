@using Inventario.AplicacionWeb.Models.ViewModels
@model List<VMRequisicionMaestra>
@{
    ViewData["Title"] = "TablaRequisiciones";
}

<div class="tabla-requi-page" data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")" data-url-ver-pdf="@Url.Action("VerParaPdf", "Requisicion")">
    <div class="tabla-requi-header">
        <div>
            <h1 class="tabla-requi-titulo">Requisiciones</h1>
            <p class="tabla-requi-subtitulo">Gestión y seguimiento de requisiciones</p>
        </div>
        @if (User.IsInRole("1"))
        {
            <a href="#" class="boton-rosa" data-bs-toggle="modal" data-bs-target="#modalNuevaRequisicion">
                <i class="fa-solid fa-plus"></i> Nueva Requisición
            </a>
        }
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>Nº Requisición</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly
                       style="width:100%;" />
                <button type="button" id="btnLimpiarFecha" onclick="limpiarFecha()"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>        
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
    </div>

    <div class="container-formulario tabla-container">
        <table class="tabla-requisiciones">
            <thead>
                <tr>
                    <th>Folio</th>
                    <th>Fecha de emisión</th>
                    <th>Departamento</th>
                    <th>Responsable</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.NumRequi</td>
                        <td>@item.FechaEmision</td>
                        <td>@item.Departamento</td>
                        <td>@item.Responsable</td>
                        <td>@item.Estatus</td>
                        <td>
                            <div class="acciones-grupo">
                                <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                    <i class="fa-solid fa-eye"></i>
                                </button>
                                @if (item.Estatus == "REQUISICION MODIFICACIÓN" && User.IsInRole("1"))
                                {
                                    <button class="btn-accion btn-editar" title="Editar">
                                        <i class="fa-solid fa-pen"></i>
                                    </button>
                                }
                                <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                    <i class="fa-solid fa-file-pdf"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal tipo de requisición (mismo estilo que Artículos de la Requisición) -->
<div class="modal" id="modalNuevaRequisicion" tabindex="-1" aria-labelledby="modalNuevaRequisicionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-nueva-requisicion">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">         
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="modalNuevaRequisicionLabel">Nueva Requisición</h5>
                    <p class="modal-subtitulo-premium">Seleccione el tipo de requisición para continuar</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body modal-body-premium modal-body-nueva-requisicion">
                <div class="btn-stack">
                    <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="btn btn-primary-nueva">
                        <span class="btn-icon-nueva"><i class="fa-solid fa-clipboard-list"></i></span>
                        <span class="btn-text">Requisición General<small>Bienes y suministros varios</small></span>
                    </a>
                    @if (DateTime.Now.Day <= 5 || int.TryParse(User.FindFirst("IdDepartamento")?.Value, out int idDep) && idDep == 29)
                    {
                        <a href="@Url.Action("FormularioRequisiciones", "Requisicion", new { tipo = "mensual" })" class="btn btn-secondary-nueva">
                            <span class="btn-icon-nueva"><i class="fa-solid fa-box"></i></span>
                            <span class="btn-text">Requisición de Materiales Mensual<small>Abastecimiento recurrente del mes</small></span>
                        </a>
                    }
                    <button type="button" class="btn btn-ghost-nueva" title="Próximamente">
                        <span class="btn-icon-nueva"><i class="fa-solid fa-wrench"></i></span>
                        <span class="btn-text">Requisición de Servicios<small>Mantenimiento, consultoría o soporte</small></span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="modalDetalle" tabindex="-1" aria-labelledby="detalleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="detalleLabel">Artículos de la Requisición</h5>
                    <p class="modal-subtitulo-premium">Detalle de partidas solicitadas</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body modal-body-premium">
                <table class="tabla-requisiciones" id="tablaModalDetalle">
                    <thead>
                        <tr>
                            <th>Nº Partida</th>
                            <th>ID Artículo</th>
                            <th>Cantidad</th>
                            <th>Unidad Medida</th>
                            <th>Descripción</th>
                            <th>Descripción Detallada</th>
                        </tr>
                    </thead>
                    <tbody id="tablaDetalle">
                        <!-- Se carga dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Panel de descripción detallada — fuera del modal para evitar clipping -->
<div id="desc-panel-modal" style="display:none;">
    <div class="desc-panel-modal-header">
        <span class="desc-panel-modal-titulo">Descripción detallada</span>
        <button type="button" class="desc-panel-modal-cerrar" onclick="cerrarDescPanelModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <textarea id="desc-textarea-modal" class="desc-textarea" readonly rows="5"></textarea>
</div>

@section Scripts {
    <script src="~/js/requisicion/tabla-requisiciones.js" asp-append-version="true"></script>
}