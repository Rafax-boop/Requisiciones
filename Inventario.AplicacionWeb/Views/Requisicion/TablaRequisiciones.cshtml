@using Inventario.AplicacionWeb.Models.ViewModels
@using Inventario.AplicacionWeb.Utilidades
@model VMTablaRequisiciones
@{
    ViewData["Title"] = "TablaRequisiciones";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/tabla-requisiciones.css" asp-append-version="true" />
}

<div class="tabla-requi-page" data-tipo-tabla="materiales"
     data-url-notif-snapshot="@Url.Action("SnapshotIdsPorTab", "Requisicion")"
     data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")"
     data-url-ver-pdf="@Url.Action("VerParaPdf", "Requisicion")"
     data-url-usuarios-materiales="@Url.Action("ObtenerUsuariosMateriales", "Requisicion")"
     data-url-asignar=" @Url.Action("AsignarRequisicion", "Requisicion")"
     data-url-atender="@Url.Action("Atender", "Requisicion")"
     data-url-buscar-cogs="@Url.Action("BuscarCogs", "Requisicion")"
     data-url-enviar-almacen="@Url.Action("EnviarAAlmacen", "Requisicion")"
     data-url-rechazar="@Url.Action("RechazarRequisicion", "Requisicion")"
     data-url-modificar="@Url.Action("EnviarAModificacion", "Requisicion")"
     data-url-obtener-progreso="@Url.Action("ObtenerProgresoRequisicion", "Requisicion")"
     data-url-historial-pdf="@Url.Action("HistorialParaPdf", "Requisicion")"
     data-url-subir-archivos-atencion="@Url.Action("SubirArchivosAtencion", "Requisicion")"
     data-url-aceptar-expediente="@Url.Action("AceptarExpediente", "Servicios")"
     data-url-subir-doc-proveedor="@Url.Action("SubirDocumentoProveedor", "Requisicion")"
     data-url-obtener-docs-proveedor="@Url.Action("ObtenerDocumentosProveedor", "Requisicion")"
     data-url-enviar-financieros-docs="@Url.Action("EnviarAFinancierosConDocs", "Requisicion")"
     data-url-rebotar-documentos="@Url.Action("RebotarDocumentos", "Requisicion")"
     data-url-descargar-cuadro-comparativo="@Url.Action("DescargarCuadroComparativo", "Requisicion")"
     data-url-guardar-cotizaciones="@Url.Action("GuardarCotizaciones", "Requisicion")"
     data-url-obtener-cotizaciones="@Url.Action("ObtenerCotizaciones", "Requisicion")"
     data-url-obtener-partidas="@Url.Action("ObtenerPartidas", "Requisicion")"
     data-url-obtener-opciones-ganador="@Url.Action("ObtenerOpcionesGanador", "Requisicion")"
     data-url-obtener-ganador="@Url.Action("ObtenerProveedorGanador", "Requisicion")"
     data-url-guardar-ganador="@Url.Action("GuardarProveedorGanador", "Requisicion")"
     data-url-obtener-pedido="@Url.Action("ObtenerPedidoEditable", "Financieros")"
     data-url-generar-pedido-pdf="@Url.Action("GenerarPedidoPdf", "Financieros")"
     data-url-subir-documento-pedido="@Url.Action("SubirDocumentoPedido", "Requisicion")"
      data-url-obtener-archivos="@Url.Action("ObtenerRequisicionesConArchivos", "Requisicion")"
      data-url-consolidadas-documentos="@Url.Action("ObtenerConsolidadasConArchivos", "Requisicion")"
     data-url-obtener-todos-archivos="@Url.Action("ObtenerTodosLosArchivos", "Requisicion")"
     data-url-descargar-todos-archivos-zip="@Url.Action("DescargarTodosLosArchivosZip", "Requisicion")"
     data-url-descargar-req-directa="@Url.Action("DescargarReqDirecta", "Requisicion")"
     data-url-obtener-id-adquisicion="@Url.Action("ObtenerIdAdquisicion", "Requisicion")"
     data-url-requis-consolidables="@Url.Action("ObtenerRequisicionesConsolidables", "Consolidada")"
     data-url-crear-consolidada="@Url.Action("CrearConsolidada", "Consolidada")"
     data-url-listar-consolidadas="@Url.Action("ListarConsolidadas", "Consolidada")"
     data-url-consolidadas-autorizadas="@Url.Action("ObtenerConsolidadasAutorizadas", "Consolidada")"
     data-url-detalle-consolidada="@Url.Action("ObtenerDetalleConsolidada", "Consolidada")"
     data-url-atender-consolidada="@Url.Action("AtenderConsolidada", "Consolidada")"
     data-url-subir-archivos-consolidada="@Url.Action("SubirArchivosAtencionConsolidada", "Consolidada")"
     data-url-partidas-consolidada="@Url.Action("ObtenerPartidasConsolidada", "Consolidada")"
     data-url-obtener-opciones-ganador-consolidada="@Url.Action("ObtenerOpcionesGanadorConsolidada", "Requisicion")"
     data-url-descargar-cuadro-consolidada="@Url.Action("DescargarCuadroComparativoConsolidada", "Requisicion")"
      data-url-descargar-req-directa-consolidada="@Url.Action("DescargarReqDirectaConsolidada", "Requisicion")"
      data-url-obtener-archivos-consolidada="@Url.Action("ObtenerArchivosConsolidada", "Consolidada")"
      data-url-descargar-archivos-consolidada-zip="@Url.Action("DescargarArchivosConsolidadaZip", "Consolidada")"
      data-url-consolidadas-verificadas="@Url.Action("ObtenerConsolidadasVerificadas", "Consolidada")"
     data-url-expediente-consolidada="@Url.Action("ObtenerExpedienteConsolidada", "Consolidada")"
     data-url-subir-doc-proveedor-consolidada="@Url.Action("SubirDocumentoProveedorConsolidada", "Consolidada")"
     data-url-obtener-docs-proveedor-consolidada="@Url.Action("ObtenerDocumentosProveedorConsolidada", "Consolidada")"
     data-url-editar-pedido-consolidada="@Url.Action("EditarPedidoCompraConsolidada", "Financieros")"
     data-url-generar-pedido-pdf-consolidada="@Url.Action("GenerarPedidoPdfConsolidada", "Financieros")"
     data-url-enviar-financieros-docs-consolidada="@Url.Action("EnviarFinancierosConsolidada", "Financieros")"
     data-url-asignar-analista-consolidada="@Url.Action("AsignarAnalistaConsolidada", "Consolidada")">
    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Requisiciones</h1>
            <p class="tabla-requi-subtitulo">GestiÃ³n y seguimiento de requisiciones</p>
        </div>
        @if (User.IsInRole("1"))
        {
            @if (DateTime.Now.Day <= 5 || int.Parse(User.FindFirst("IdDepartamento")?.Value ?? "0") == 29)
            {
                <a href="#" class="boton-rosa" data-bs-toggle="modal" data-bs-target="#modalNuevaRequisicion">
                    <i class="fa-solid fa-plus"></i> Nueva RequisiciÃ³n
                </a>
            }
            else
            {
                <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="boton-rosa">
                    <i class="fa-solid fa-plus"></i> Nueva RequisiciÃ³n
                </a>
            }
        }
        @if (User.IsInRole("4"))
        {
            <a href="#" class="boton-gris"
                   data-bs-toggle="modal"
                   data-bs-target="#modalCrearConsolidada"
                   onclick="abrirModalConsolidada()">
                <i class="fa-solid fa-layer-group"></i> Crear Consolidada
            </a>
        }
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>NÂº RequisiciÃ³n</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly style="width:100%;" />
                <button type="button" id="btnLimpiarFecha" onclick="limpiarFecha()"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
        <div class="filtro-grupo">
            <label>Estado</label>
            <select id="filtroEstado" class="filtro-select-almacen">
                <option value="">Todos los estados</option>
                @foreach (var e in Model.Estatus)
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
    </div>

    <nav class="almacen-tabs">
        <button type="button" class="almacen-tabs-btn activo" data-tab="principal">En seguimiento</button>
        @if (!User.IsInRole("1"))
        {
            <button type="button" class="almacen-tabs-btn" data-tab="consolidadas">
                Requisiciones consolidadas
            </button>
            <button type="button" class="almacen-tabs-btn" data-tab="verificadas">Requisiciones verificadas</button>
        }
        <button type="button" class="almacen-tabs-btn" data-tab="autorizadas">Requisiciones autorizadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="rechazadas">Requisiciones rechazadas</button>
        @if (!User.IsInRole("1"))
        {
            <button type="button" class="almacen-tabs-btn" data-tab="documentos">Requisiciones con documentos</button>
        }
    </nav>

    @{
        var numColsReq = 8;
        if (User.IsInRole("4")) numColsReq++;
        if (User.IsInRole("3") || User.IsInRole("4")) numColsReq++;
        var requisicionesPrincipal = Model.Requisiciones.Where(r => r.ConsolidadaId == null && r.IdEstatus != 7 && r.IdEstatus != 5 && r.IdEstatus != 12).ToList(); ;
        @if (User.IsInRole("1"))
        {
            requisicionesPrincipal = Model.Requisiciones.Where(r => r.IdEstatus != 7 && r.IdEstatus != 5 && r.IdEstatus != 12).ToList();
        }
        var requisicionesAutorizadas = Model.Requisiciones.Where(r => (r.IdEstatus == 7 || r.IdEstatus == 12) && r.ConsolidadaId == null).ToList();
        var requisicionesRechazadas = Model.Requisiciones.Where(r => r.IdEstatus == 5 && r.ConsolidadaId == null).ToList();
        var requisicionesVerificadas = Model.Requisiciones.Where(r => (r.IdEstatus == 15 || r.IdEstatus == 18) && r.ConsolidadaId == null).ToList();
    }

    <!-- PestaÃ±a En seguimiento -->
    <div id="tab-principal" class="almacen-tab-panel activo">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesPrincipal">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisiÃ³n</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Partida(s)</th>
                        <th>Estado</th>
                        @if (User.IsInRole("4"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("3") || User.IsInRole("4"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idxPrincipal = 0; }
                    @foreach (var item in requisicionesPrincipal)
                    {
                        idxPrincipal++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi">
                            <td style="text-align:center">@idxPrincipal</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerFolio(item.NumRequi))</td>
                            <td>@item.FechaEmision</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Departamento, "fa-solid fa-building"))</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Responsable, "fa-solid fa-user"))</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("4"))
                            {
                                <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.NombreAsignado ?? "Sin asignar", "fa-solid fa-clipboard-user"))</td>
                            }
                            @if (User.IsInRole("3") || User.IsInRole("4"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorP = item.DiasAsignado <= 3 ? "badge-semaforo-verde" : (item.DiasAsignado <= 6 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorP">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " dÃ­a" : " dÃ­as"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    @if (User.IsInRole("1") || item.IdEstatus <= 2 || item.IdEstatus == 11)
                                    {
                                        <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                            <i class="fa-solid fa-eye"></i></button>
                                    }
                                    @if (item.IdEstatus == 3 && User.IsInRole("1"))
                                    {
                                        <a href="@Url.Action("EditarRequisicion", "Requisicion", new { id = item.IdRequi })"
                                           class="btn-accion btn-editar" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                    @if (User.IsInRole("4") && (item.IdEstatus == 1 || item.IdEstatus == 11))
                                    {
                                        <button class="btn-accion" title="Asignar RequisiciÃ³n" onclick="abrirModalAsignar(@item.IdRequi, @item.IdEstatus)">
                                            <i class="fa-solid fa-clipboard-user"></i>
                                        </button>
                                    }
                                    @if (User.IsInRole("3") && item.IdEstatus == 2)
                                    {
                                        <button class="btn-accion" title="Atender" onclick="atenderRequisicion(@item.IdRequi)">
                                            <i class="fa-solid fa-hand-holding"></i>
                                        </button>
                                    }
                                    @if (!User.IsInRole("1") && item.IdEstatus > 2 && item.IdEstatus != 11)
                                    {
                                        <button class="btn-accion btn-ver" title="Ver detalle"
                                                onclick="verDetalle(@item.IdRequi, 'readonly')">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (fase, esTerminal, esMod, progress) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progress)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisici&oacute;n Capturada</strong>
                                                <span>Emisi&oacute;n @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotizaci&oacute;n</div>
                                            <div class="step-tooltip">
                                                <strong>Cotizaci&oacute;n / Presupuesto</strong>
                                                <span>@(fase >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 3 ? (esMod ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esMod ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@Html.Raw(esMod ? "A Modificar" : "Tr&aacute;mite")</div>
                                            <div class="step-tooltip">
                                                <strong>@Html.Raw(esMod ? "Modificaci&oacute;n" : "Tr&aacute;mite Operativo")</strong>
                                                <span>@(esMod ? "Regresada para cambios" : (fase >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">AutorizaciÃ³n</div>
                                            <div class="step-tooltip">
                                                <strong>AutorizaciÃ³n Documental</strong>
                                                <span>@(fase >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(fase >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesPrincipal.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones en seguimiento</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- PestaÃ±a Requisiciones autorizadas -->
    <div id="tab-autorizadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesAutorizadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisiÃ³n</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Partida(s)</th>
                        <th>Estado</th>
                        @if (User.IsInRole("4"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("3") || User.IsInRole("4"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyAutorizadasIndividuales">
                    @{ var idxAutorizadas = 0; }
                    @foreach (var item in requisicionesAutorizadas)
                    {
                        idxAutorizadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi">
                            <td style="text-align:center">@idxAutorizadas</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerFolio(item.NumRequi))</td>
                            <td>@item.FechaEmision</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Departamento, "fa-solid fa-building"))</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Responsable, "fa-solid fa-user"))</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("4"))
                            {
                                <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.NombreAsignado ?? "Sin asignar", "fa-solid fa-clipboard-user"))</td>
                            }
                            @if (User.IsInRole("3") || User.IsInRole("4"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorA = item.DiasAsignado <= 3 ? "badge-semaforo-verde" : (item.DiasAsignado <= 6 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorA">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " dÃ­a" : " dÃ­as"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (faseA, esTerminalA, esModA, progA) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progA)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisici&oacute;n Capturada</strong>
                                                <span>Emisi&oacute;n @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotizaci&oacute;n</div>
                                            <div class="step-tooltip">
                                                <strong>Cotizaci&oacute;n / Presupuesto</strong>
                                                <span>@(faseA >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 3 ? (esModA ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esModA ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@Html.Raw(esModA ? "A Modificar" : "Tr&aacute;mite")</div>
                                            <div class="step-tooltip">
                                                <strong>@Html.Raw(esModA ? "Modificaci&oacute;n" : "Tr&aacute;mite Operativo")</strong>
                                                <span>@(esModA ? "Regresada para cambios" : (faseA >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
