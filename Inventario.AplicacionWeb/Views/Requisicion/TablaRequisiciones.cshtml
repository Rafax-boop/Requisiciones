@using Inventario.AplicacionWeb.Models.ViewModels
@using Inventario.AplicacionWeb.Utilidades
@model VMTablaRequisiciones
@{
    ViewData["Title"] = "TablaRequisiciones";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/tabla-requisiciones.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="tabla-requi-page" data-tipo-tabla="materiales" data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")"
     data-url-ver-pdf="@Url.Action("VerParaPdf", "Requisicion")"
     data-url-usuarios-materiales="@Url.Action("ObtenerUsuariosMateriales", "Requisicion")"
     data-url-asignar=" @Url.Action("AsignarRequisicion", "Requisicion")"
     data-url-atender="@Url.Action("Atender", "Requisicion")"
     data-url-buscar-cogs="@Url.Action("BuscarCogs", "Requisicion")"
     data-url-enviar-almacen="@Url.Action("EnviarAAlmacen", "Requisicion")"
     data-url-rechazar="@Url.Action("RechazarRequisicion", "Requisicion")"
     data-url-modificar="@Url.Action("EnviarAModificacion", "Requisicion")"
     data-url-obtener-progreso="@Url.Action("ObtenerProgresoRequisicion", "Requisicion")"
     data-url-subir-archivos-atencion="@Url.Action("SubirArchivosAtencion", "Requisicion")"
     data-url-aceptar-expediente="@Url.Action("AceptarExpediente", "Servicios")"
     data-url-subir-doc-proveedor="@Url.Action("SubirDocumentoProveedor", "Requisicion")"
     data-url-obtener-docs-proveedor="@Url.Action("ObtenerDocumentosProveedor", "Requisicion")"
     data-url-enviar-financieros-docs="@Url.Action("EnviarAFinancierosConDocs", "Requisicion")"
     data-url-rebotar-documentos="@Url.Action("RebotarDocumentos", "Requisicion")">
    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Requisiciones</h1>
            <p class="tabla-requi-subtitulo">Gestión y seguimiento de requisiciones</p>
        </div>
        @if (User.IsInRole("1"))
        {
            @if (DateTime.Now.Day <= 5 || int.Parse(User.FindFirst("IdDepartamento")?.Value ?? "0") == 29)
            {
                <a href="#" class="boton-rosa" data-bs-toggle="modal" data-bs-target="#modalNuevaRequisicion">
                    <i class="fa-solid fa-plus"></i> Nueva Requisición
                </a>
            }
            else
            {
                <a href="@Url.Action("FormularioRequisiciones", "Requisicion")" class="boton-rosa">
                    <i class="fa-solid fa-plus"></i> Nueva Requisición
                </a>
            }
        }
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>Nº Requisición</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly style="width:100%;" />
                <button type="button" id="btnLimpiarFecha" onclick="limpiarFecha()"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
        <div class="filtro-grupo">
            <label>Estado</label>
            <select id="filtroEstado" class="filtro-select-almacen">
                <option value="">Todos los estados</option>
                @foreach (var e in Model.Estatus)
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
    </div>

    <nav class="almacen-tabs">
        <button type="button" class="almacen-tabs-btn activo" data-tab="principal">En seguimiento</button>
        <button type="button" class="almacen-tabs-btn" data-tab="autorizadas">Requisiciones autorizadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="rechazadas">Requisiciones rechazadas</button>
    </nav>

    @{
        var numColsReq = 8;
        if (User.IsInRole("4")) numColsReq++;
        if (User.IsInRole("3") || User.IsInRole("4")) numColsReq++;
        var requisicionesPrincipal = Model.Requisiciones.Where(r => r.IdEstatus != 4 && r.IdEstatus != 5).ToList();
        var requisicionesAutorizadas = Model.Requisiciones.Where(r => r.IdEstatus == 4).ToList();
        var requisicionesRechazadas = Model.Requisiciones.Where(r => r.IdEstatus == 5).ToList();
        var requisicionesVerificadas = Model.Requisiciones.Where(r => r.IdEstatus == 16 || r.IdEstatus == 18).ToList();
    }

    <!-- Pestaña En seguimiento -->
    <div id="tab-principal" class="almacen-tab-panel activo">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesPrincipal">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Items</th>
                        <th>Estado</th>
                        @if (User.IsInRole("4"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("3") || User.IsInRole("4"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idxPrincipal = 0; }
                    @foreach (var item in requisicionesPrincipal)
                    {
                        idxPrincipal++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi">
                            <td style="text-align:center">@idxPrincipal</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@item.Estatus</td>
                            @if (User.IsInRole("4"))
                            {
                                <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                            }
                            @if (User.IsInRole("3") || User.IsInRole("4"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorP = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorP">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    @if (!User.IsInRole("3"))
                                    {
                                        <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                            <i class="fa-solid fa-eye"></i></button>
                                    }
                                    @if (item.IdEstatus == 3 && User.IsInRole("1"))
                                    {
                                        <a href="@Url.Action("EditarRequisicion", "Requisicion", new { id = item.IdRequi })"
                                           class="btn-accion btn-editar" title="Editar">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                    @if (User.IsInRole("4") && (item.IdEstatus == 1 || item.IdEstatus == 11))
                                    {
                                        <button class="btn-accion" title="Asignar Requisición" onclick="abrirModalAsignar(@item.IdRequi, @item.IdEstatus)">
                                            <i class="fa-solid fa-clipboard-user"></i>
                                        </button>
                                    }
                                    @if (User.IsInRole("3") && item.IdEstatus == 2)
                                    {
                                        <button class="btn-accion" title="Atender" onclick="atenderRequisicion(@item.IdRequi)">
                                            <i class="fa-solid fa-hand-holding"></i>
                                        </button>
                                    }
                                    @if (User.IsInRole("3") && item.IdEstatus != 2)
                                    {
                                        <button class="btn-accion btn-ver" title="Ver detalle"
                                                onclick="verDetalle(@item.IdRequi, 'readonly')">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (fase, esTerminal, esMod, progress) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progress)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisición Capturada</strong>
                                                <span>Emisión @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotización</div>
                                            <div class="step-tooltip">
                                                <strong>Cotización / Presupuesto</strong>
                                                <span>@(fase >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 3 ? (esMod ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esMod ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@(esMod ? "A Modificar" : "Trámite")</div>
                                            <div class="step-tooltip">
                                                <strong>@(esMod ? "Modificación" : "Trámite Operativo")</strong>
                                                <span>@(esMod ? "Regresada para cambios" : (fase >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(fase >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(fase >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesPrincipal.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones en seguimiento</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones autorizadas -->
    <div id="tab-autorizadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesAutorizadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Items</th>
                        <th>Estado</th>
                        @if (User.IsInRole("4"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("3") || User.IsInRole("4"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idxAutorizadas = 0; }
                    @foreach (var item in requisicionesAutorizadas)
                    {
                        idxAutorizadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi">
                            <td style="text-align:center">@idxAutorizadas</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@item.Estatus</td>
                            @if (User.IsInRole("4"))
                            {
                                <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                            }
                            @if (User.IsInRole("3") || User.IsInRole("4"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorA = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorA">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (faseA, esTerminalA, esModA, progA) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progA)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisición Capturada</strong>
                                                <span>Emisión @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotización</div>
                                            <div class="step-tooltip">
                                                <strong>Cotización / Presupuesto</strong>
                                                <span>@(faseA >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 3 ? (esModA ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esModA ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@(esModA ? "A Modificar" : "Trámite")</div>
                                            <div class="step-tooltip">
                                                <strong>@(esModA ? "Modificación" : "Trámite Operativo")</strong>
                                                <span>@(esModA ? "Regresada para cambios" : (faseA >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(faseA >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(faseA >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesAutorizadas.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones autorizadas</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionAutorizadas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones rechazadas -->
    <div id="tab-rechazadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesRechazadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Items</th>
                        <th>Estado</th>
                        @if (User.IsInRole("4"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("3") || User.IsInRole("4"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idxRechazadas = 0; }
                    @foreach (var item in requisicionesRechazadas)
                    {
                        idxRechazadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi">
                            <td style="text-align:center">@idxRechazadas</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@item.Estatus</td>
                            @if (User.IsInRole("4"))
                            {
                                <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                            }
                            @if (User.IsInRole("3") || User.IsInRole("4"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorR = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorR">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    <div class="p-3 text-center" style="border:1px solid #fecaca;border-radius:10px;background:#fef2f2;">
                                        <p class="mb-1" style="color:#b91c1c;font-weight:700;"><i class="fa-solid fa-circle-xmark"></i> Requisición rechazada</p>
                                        <p class="text-muted small mb-2">El folio ya no está en seguimiento activo.</p>
                                        <button type="button" class="btn btn-sm" style="border:1px solid #fecaca;background:white;color:#b91c1c;" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                            <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesRechazadas.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones rechazadas</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRechazadas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones verificadas -->
    <div id="tab-verificadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesVerificadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th>Items</th>
                        <th>Estado</th>
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxVerificadas = 0;
                    }
                    @foreach (var item in requisicionesVerificadas)
                    {
                        idxVerificadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi">
                            <td style="text-align:center">@idxVerificadas</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@item.Estatus</td>
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver expediente completo"
                                            onclick="verExpediente(@item.IdRequi)">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesVerificadas.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="8" class="text-center">No hay requisiciones verificadas</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionVerificadas" class="almacen-paginacion"></div>
        </div>
    </div>
</div>

