@model Inventario.AplicacionWeb.Models.ViewModels.VMRequiForm
@{
    ViewData["Title"] = "Formulario Requisición de Servicios";
    bool modoEdicion = ViewBag.ModoEdicion == true;
    var tipoServicio = Model.TipoServicio ?? "no hay";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link rel="stylesheet" href="~/css/componentes/calendario.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/formulario-requisiciones.css" asp-append-version="true" />
}

<div class="mt-3 container" style="width:1600px;" data-url-buscar-articulos="@Url.Action("BuscarArticulos", "Servicios")" data-url-obtener-info-articulo="@Url.Action("ObtenerInfoArticulo", "Servicios")" data-tipo-requisicion="servicio">
    <form asp-action="@(modoEdicion ? "ActualizarRequisicion" : "CrearRequisicion")" method="post" enctype="multipart/form-data" class="no-loader">
        <input type="hidden" asp-for="IdRequiMaestra" />
        <div class="info-requisicion">
            <div class="fantasma">
                <div class="filtro-grupo">
                    <label class="m-0 info-body">Fecha de emisión:</label>
                    <label class="info-body">@DateTime.Now.ToString("dd-MM-yyyy")</label>
                </div>
            </div>
            <div class="container-info">
                <p class="info-titulo mt-3">Requisición de servicios</p>
            </div>
            <div class="requisicion-info">
                <div class="requisicion">
                    <p class="info-body">Requisición:</p>
                    <label class="info-body">@Model.NumRequisicion</label>
                </div>
            </div>
        </div>

        @if (modoEdicion)
        {
            <div class="container-formulario">
                <label class="info-body">Observaciones de Modificación:</label>
                <textarea name="ObservacionesBitacora" rows="3" readonly disabled
                      placeholder="Observaciones previas de modificación (solo lectura)"
                      class=" form-control" style="font-family: var(--font-body)">@Model.ObservacionesBitacora</textarea>
                <small class="form-text text-muted">Estas son las observaciones de la última modificación requerida</small>
            </div>
        }

        <div class="container-formulario">
            <div class="seccion-1">
                <div class="formulario-input">
                    <label>Departamento solicitante:</label>
                    <input asp-for="IdDepartamento" type="hidden" />
                    <input type="text" placeholder="Ej: Recursos Humanos" value="@Model.Departamento" readonly />
                </div>
                <div class="formulario-input">
                    <label>Responsable:</label>
                    <input asp-for="NomDirector" type="hidden" />
                    <input type="text" name="NomResponsableDepartamento" placeholder="Nombre completo"
                           value="@Model.NomResponsableDepartamento" readonly />
                </div>
            </div>
            <div class="seccion-2">
                <div class="formulario-input">
                    <label>Correo:</label>
                    <input type="email" name="Correo" placeholder="correo@ejemplo.com" value="@Model.Correo" required />
                </div>
                <div class="formulario-input">
                    <label>Teléfono:</label>
                    <input type="tel" name="Telefono" placeholder="(222) 000-0000" value="@Model.Telefono" required />
                </div>
            </div>
        </div>

        <div class="container-formulario">
            <div class="seccion-completa">
                <label class="info-titulo text-center">Datos del servicio</label>
                <div class="formulario-input">
                    <label>Especificar tipo de servicio solicitado:</label>
                    <select id="tipoServicio" name="TipoServicio" class="rosa-select-form" style="width:100%" required>
                        <option value="">-- Seleccionar tipo --</option>
                        <option value="Mantenimiento" selected="@(tipoServicio == "Mantenimiento")">Mantenimiento</option>
                        <option value="Servicio Proveedor" selected="@(tipoServicio == "Servicio Proveedor")">Servicio Proveedor</option>
                        <option value="Servicio Impresion" selected="@(tipoServicio == "Servicio Impresion")">Servicio Impresión</option>
                        <option value="Mobiliario" selected="@(tipoServicio == "Mobiliario")">Mobiliario para Eventos</option>
                    </select>
                </div>
                <div class="formulario-input">
                    <label>Justificación del servicio solicitado:</label>
                    <textarea type="text" name="Justificacion" placeholder="Justifique el servicio solicitado" value=""
                              required>@Model.Justificacion</textarea>
                </div>
                <div class="formulario-input">
                    <label>Fecha de prestación del servicio:</label>
                    <input type="text" id="fechaServicio" name="FechaServicio" placeholder="Seleccionar fecha"
                           readonly required value="@Model.FechaServicio?.ToString("yyyy-MM-dd")"/>
                </div>
                <div class="formulario-input">
                    <label>Lugar de prestación del servicio:</label>
                    <input type="text" name="LugarEntrega" placeholder="Lugar de prestación del servicio" value="@Model.LugarEntrega"
                           required />
                </div>
                @*<div class="formulario-input">
                    <label>Nombre y puesto del enlace administrativo del area solicitante:</label>
                    <textarea type="text" name="NombrePuesto" placeholder="Nombre y puesto" value="" required></textarea>
                </div>
                <div class="formulario-input">
                    <label>Número celular del enlace adaministrativo del area solicitante:</label>
                    <input type="tel" min="7" max="12" name="NumeroCelular" placeholder="(222) 000-0000" value=""
                           required />
                </div> *@
                <div class="formulario-input" id="seccionFotos" style="display:none;">
                    <label>Fotos de referencia:</label>
                    @if (modoEdicion && Model.FotosExistentes != null && Model.FotosExistentes.Any())
                    {
                        <div style="margin-bottom:12px;">
                            <small class="text-muted">Fotos guardadas â€” click en âœ• para eliminar:</small>
                            <div style="display:flex; flex-wrap:wrap; gap:8px; margin-top:6px;" 
                                 id="fotosExistentes">
                                @foreach (var foto in Model.FotosExistentes)
                                {
                                    <div style="position:relative; display:inline-block;" 
                                         class="foto-existente-wrapper" 
                                         id="foto-wrapper-@foto.IdFoto">
                                        <img src="@foto.Ruta"
                                             class="modal-galeria-foto-thumb"
                                             style="width:80px; height:80px;"
                                             onclick="abrirVisorImagen('@foto.Ruta')"
                                             title="Ver imagen" alt="" />
                                        <span onclick="eliminarFotoExistente(@foto.IdFoto)"
                                              style="position:absolute; top:-5px; right:-5px;
                                                     background:red; color:white; border-radius:50%;
                                                     width:18px; height:18px; font-size:11px;
                                                     display:flex; align-items:center; justify-content:center;
                                                     cursor:pointer;"
                                              title="Eliminar foto">âœ•</span>
                                    </div>
                                }
                            </div>
                        </div>
                        <small class="info-body">Subir nuevas fotos:</small>
                    }
                    <input type="file" id="inputFotos" name="Fotos" multiple accept="image/*" class="input-file-rosa" />
    
                    <div id="previsualizacionFotos" style="display:flex; flex-wrap:wrap; gap:8px; margin-top:10px;"></div>
                </div>
            </div>
        </div>

        <div class="container-formulario">
            <div class="seccion-completa">
                <h5 class="mb-3 text-center">Artículos solicitados</h5>
                <table class="table table-bordered" id="tablaArticulos">
                    <thead>
                        <tr>
                            <th style="width: 30%">Descripción</th>
                            <th style="width: 15%">Unidad</th>
                            <th style="width: 10%">Cantidad</th>
                            <th style="width: 10%">Descripción Detallada</th>
                            <th style="width: 10%">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Las filas se agregarán dinámicamente -->
                    </tbody>
                </table>
                <button type="button" class="btn boton-gris" onclick="agregarArticulo()">
                    <i class="fa-solid fa-plus"></i>  Agregar
                </button>
            </div>
        </div>

        <div class="container-formulario mt-4">
            <div class="seccion-completa text-center">
                @if (modoEdicion)
                {
                    <button type="button" class="btn boton-rosa btn-lg" id="btnGuardarEdicion">Guardar cambios</button>
                }
                else
                {
                    <button type="button" class="btn boton-rosa btn-lg" id="btnContinuar">
                        Continuar <i class="fa-solid fa-arrow-right"></i>
                    </button>
                    <button type="submit" class="btn boton-rosa btn-lg" id="btnGuardarFinal" style="display:none;">
                        Crear Requisición
                    </button>
                }
            </div>
        </div>
    </form>
</div>

<div id="desc-panel-global" style="display:none;">
    <textarea id="desc-textarea-global"
              class="desc-textarea"
              placeholder="Escribe la descripción detallada aquí..."></textarea>
</div>

<!-- Modal wizard distribución por municipio -->
<div class="modal fade" id="modalMunicipiosWizard" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium">Distribución por municipio</h5>
                    <p class="modal-subtitulo-premium" id="wizardMuniSubtitulo">Partida 1 de 1</p>
                </div>
            </div>
            <style>
                .municipios-section { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px 24px; }
                .municipios-section-title { font-size: 13px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .04em; margin-bottom: 14px; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px; }
                .municipios-info { font-size: 12px; margin-bottom: 16px; color: #64748b; display: flex; gap: 24px; }
                .municipios-info strong { color: #334155; font-weight: 600; }
                .municipios-grid-wrap { overflow-x: auto; margin-bottom: 16px; }
                .municipios-table { width: 100%; border-collapse: collapse; font-size: 13px; }
                .municipios-table th { background: #f8fafc; color: #475569; font-weight: 700; text-align: center; padding: 8px 10px; border: 1px solid #e2e8f0; font-size: 12px; }
                .municipios-table th:first-child { text-align: left; }
                .municipios-table td { padding: 10px; border: 1px solid #e2e8f0; vertical-align: middle; }
                .municipios-table td:first-child { font-weight: 500; color: #1a1a1a; }
                .municipios-input { width: 100% !important; padding: 6px 10px !important; border: 1.5px solid #cbd5e1 !important; border-radius: 6px !important; font-size: 13px !important; font-weight: 500 !important; color: #334155 !important; background: #f8fafc !important; outline: none !important; transition: all 0.3s ease !important; text-align: center !important; }
                .municipios-input:focus { border-color: #ec4081 !important; background: #fff !important; box-shadow: 0 0 0 3px rgba(255, 64, 129, 0.08) !important; }
                .municipios-table .btn-delete { background: none; border: 1.5px solid #fecaca; color: #ef4444; border-radius: 6px; padding: 6px 10px; cursor: pointer; transition: all 0.3s ease; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; }
                .municipios-table .btn-delete:hover { background: #fef2f2; border-color: #fca5a5; }
            </style>
            <div class="modal-body modal-body-premium">
                <div class="municipios-section">
                    <div class="municipios-section-title"><i class="fa-solid fa-map-location-dot"></i> Distribución de cantidad por municipio</div>

                    <p id="wizardMuniNombrePartida" style="font-size:13px; font-weight:600; color:#1a1a1a; margin:0 0 12px;"></p>

                    <!-- Indicador de cantidad -->
                    <div class="municipios-info" id="wizardMuniCantidadInfo">
                        Cantidad requerida: <strong id="wizardMuniCantidadReq">0</strong>
                        Asignada: <strong id="wizardMuniCantidadAsig" style="color:#ef4444">0</strong>
                    </div>

                    <!-- Tabla de distribución -->
                    <div class="municipios-grid-wrap">
                        <table class="municipios-table" id="wizardMuniTabla">
                            <thead>
                                <tr>
                                    <th>Municipio</th>
                                    <th>Cantidad</th>
                                    <th style="width:50px;"></th>
                                </tr>
                            </thead>
                            <tbody id="wizardMuniTbody"></tbody>
                        </table>
                    </div>

                    <button type="button" class="btn boton-gris btn-sm" id="btnWizardMuniAgregarFila">
                        <i class="fa-solid fa-plus"></i> Agregar municipio
                    </button>
                </div>
            </div>
            <div class="modal-footer" style="justify-content:space-between;">
                <button type="button" class="btn boton-gris" id="btnWizardMuniAnterior" style="display:none;">
                    <i class="fa-solid fa-chevron-left"></i> Anterior
                </button>
                <button type="button" class="btn boton-rosa" id="btnWizardMuniSiguiente">
                    Siguiente <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Mismo lightbox que Presupuesto / tablas / expediente -->
<div id="visor-imagenes-tabla" class="visor-imagenes-overlay">
    <img id="visor-imagenes-tabla-img" class="visor-imagenes-img" src="" alt="Vista previa" />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
    <script src="~/js/shared/modal-adjuntos.js" asp-append-version="true"></script>
    <script src="~/js/shared/select-rosa-buscable.js" asp-append-version="true"></script>
    <script>
    window.municipiosOpciones = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        ViewBag.ListaMunicipios != null
            ? ((List<SelectListItem>)ViewBag.ListaMunicipios).Select(m => new {
                id = m.Value,
                nombre = m.Text
            }).Cast<object>()
            : Enumerable.Empty<object>()
    ));
</script>
    <script src="~/js/requisicion/formulario-requisiciones.js" asp-append-version="true"></script>

    @if (modoEdicion && Model.Articulos != null && Model.Articulos.Any())
    {
        <script>
            window.articulosIniciales = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Articulos.Select(a => new {
                idArticulo = a.IdArticulo,
                cog        = a.Cog,
                claveMaterial = a.ClaveMaterial,
                cantidad   = a.Cantidad,
                unidadMedida = a.UnidadMedida,
                descripcion  = a.Descripcion,
                descripcionDetallada = a.DescripcionDetallada
            })))
        </script>
    }
}

