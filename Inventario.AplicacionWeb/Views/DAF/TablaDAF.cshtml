@using Inventario.AplicacionWeb.Models.ViewModels
@using Inventario.AplicacionWeb.Utilidades
@model VMTablaRequisiciones
@{
    ViewData["Title"] = "DAF";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/tabla-requisiciones.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="tabla-requi-page"
     data-url-notif-snapshot="@Url.Action("SnapshotIdsPorTab", "DAF")"
     data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")"
     data-url-ver-pdf-requi="@Url.Action("VerParaPdf", "Requisicion")"
     data-url-ver-pdf-servicio="@Url.Action("VerParaPdf", "Servicios")"
     data-url-atender="@Url.Action("Revisar", "DAF")"
     data-url-obtener-progreso="@Url.Action("ObtenerProgresoRequisicion", "Requisicion")">

    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Requisiciones</h1>
            <p class="tabla-requi-subtitulo">Revisión y visto bueno de requisiciones atendidas</p>
        </div>
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>Nº Requisición</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly style="width:100%;" />
                <button type="button" id="btnLimpiarFecha"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha" onclick="limpiarFecha()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
        <div class="filtro-grupo">
            <label>Estado</label>
            <select id="filtroEstado" class="filtro-select-almacen">
                <option value="">Todos los estados</option>
                @foreach (var e in Model.Estatus)
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
    </div>

    @{
        var numColsReq = 7; // #, Folio, Fecha, Depto, Responsable, Items, Estado, Acciones
    }

    <nav class="almacen-tabs">
        <button type="button" class="almacen-tabs-btn activo" data-tab="principal">Bandeja de revisión</button>
    </nav>

    <div id="tab-principal" class="almacen-tab-panel activo">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesPrincipal">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Partida(s)</th>
                        <th>Estado</th>
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idx = 0;
                    }
                    @foreach (var item in Model.Requisiciones)
                    {
                        idx++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi"
                            data-requi-servicio="@item.RequiServicio.ToString().ToLower()">
                            <td style="text-align:center">@idx</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle / Revisar"
                                            onclick="revisarRequisicion(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF"
                                            onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (fase, esTerminal, esMod, progress) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progress)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisición Capturada</strong>
                                                <span>Emisión @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotización</div>
                                            <div class="step-tooltip">
                                                <strong>Cotización / Presupuesto</strong>
                                                <span>@(fase >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 3 ? (esMod ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esMod ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@(esMod ? "A Modificar" : "Trámite")</div>
                                            <div class="step-tooltip">
                                                <strong>@(esMod ? "Modificación" : "Trámite Operativo")</strong>
                                                <span>@(esMod ? "Regresada para cambios" : (fase >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(fase >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline"
                                                    onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(fase >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Requisiciones.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones pendientes de revisión</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>
</div>

<!-- Modal revisión DAF -->
<div class="modal" id="modalDetalle" tabindex="-1" aria-labelledby="detalleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="detalleLabel">Revisión de Requisición</h5>
                    <p class="modal-subtitulo-premium" id="modalSubtitulo">Detalle de partidas solicitadas</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Campos PP / FF / Programa / Municipio — siempre readonly -->
            <div style="margin-top:20px;" class="px-4">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Actividad:</label>
                            <select id="actividadSeleccionada" class="form-select select2" disabled>
                                <option value="">-- Selecciona actividad --</option>
                                @foreach (var act in Model.ListaActividades)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Fuente de Financiamiento:</label>
                            <select id="ffSelect" class="form-select select2" disabled>
                                <option value="">-- Selecciona Fuente de Financiamiento --</option>
                                <option value="1">Federal</option>
                                <option value="2">Estatal</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Tipo de Programa:</label>
                            <select id="tipoProgramaSelect" class="form-select select2" disabled>
                                <option value="">-- Selecciona el Tipo de Programa --</option>
                                <option value="1">Prioritario</option>
                                <option value="2">Adicional</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Municipio:</label>
                            <select id="municipio" class="form-select select2" disabled>
                                <option value="">-- Selecciona municipio --</option>
                                @foreach (var act in Model.ListaMunicipios)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body modal-body-premium">

                <!-- Tabla de artículos -->
                <div class="table-responsive-container">
                    <table class="tabla-requisiciones" id="tablaModalDetalle">
                        <thead>
                            <tr>
                                <th>Nº Partida</th>
                                <th>Cantidad</th>
                                <th>Unidad Medida</th>
                                <th>Descripción</th>
                                <th>Descripción Detallada</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalle"></tbody>
                    </table>
                </div>

                <!-- Fotos de referencia (impresión) -->
                <div id="seccionFotosDetalle" style="display:none; margin-top:16px;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:8px;">
                        <i class="fa-solid fa-images"></i> Fotos de referencia
                    </p>
                    <div id="galeriaFotosDetalle" style="display:flex; flex-wrap:wrap; gap:10px;"></div>
                </div>

                <!-- Archivos de cotizaciones / cuadro comparativo (readonly) -->
                <div id="contenedorArchivosReadonly"></div>

                <!-- Archivos subidos por Financieros: SIAF, TablaApi + Nº API -->
                <div id="contenedorArchivosFinancieros" style="display:none; margin-top:16px;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:10px;">
                        <i class="fa-solid fa-folder-open"></i> Documentos financieros
                    </p>
                    <div id="grupoArchivosSiaf" style="margin-bottom:12px;"></div>
                    <div id="grupoArchivosTablaApi" style="margin-bottom:12px;"></div>
                    <div id="grupoNumeroApi" style="margin-bottom:4px;"></div>
                </div>

                <!-- Observaciones de financieros (readonly) -->
                <div style="margin-top:16px;">
                    <div class="formulario-input">
                        <label>Observaciones de financieros</label>
                        <textarea id="txtObservaciones" class="form-control" rows="3" readonly
                                  placeholder="Sin observaciones registradas..."></textarea>
                    </div>
                </div>

                <!-- Botón visto bueno -->
                <div id="botonesRevisar" style="margin-top:20px; text-align:right;">
                    <button type="button" class="btn boton-rosa" onclick="marcarRevisado()">
                        <i class="fa-solid fa-circle-check"></i> Marcar como revisado
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Panel descripción detallada -->
<div id="desc-panel-modal" style="display:none;">
    <div class="desc-panel-modal-header">
        <span class="desc-panel-modal-titulo">Descripción detallada</span>
        <button type="button" class="desc-panel-modal-cerrar" onclick="cerrarDescPanelModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <textarea id="desc-textarea-modal" class="desc-textarea" readonly rows="5"></textarea>
</div>

<!-- Modal historial -->
<div class="modal" id="modalHistorial" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-historial-dialog">
        <div class="modal-content modal-premium modal-historial-content">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" style="font-family: var(--font-display); font-size: 1.25rem;">Historial completo</h5>
                    <p class="modal-subtitulo-premium" id="historialSubtitle" style="font-size: 0.75rem;">Cargando...</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body modal-body-premium">
                <div class="modal-summary" id="historialSummary"></div>
                <hr class="modal-sep" style="border:none; border-top:1px solid var(--slate-200); margin: 0 0 1.4rem;">
                <div class="modal-tl" id="historialTl"></div>
            </div>
        </div>
    </div>
</div>

<!-- Lightbox imágenes -->
<div id="visor-imagenes-tabla" class="visor-imagenes-overlay">
    <img id="visor-imagenes-tabla-img" class="visor-imagenes-img" src="" alt="Vista previa" />
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
    <script src="~/js/shared/tabs-notificaciones-requi.js" asp-append-version="true"></script>
    <script src="~/js/shared/modal-adjuntos.js" asp-append-version="true"></script>
    <script src="~/js/daf/tabla-daf.js" asp-append-version="true"></script>
}