@{
    ViewData["Title"] = "Requisiciones";
}
<div class="mt-3">
    <div class="info-requisicion">
        <div class="fantasma">
            <div class="d-inline-block">
                <p class="m-0 info-body">FECHA DE EMISIÓN:</p>
                <small class="text-muted">
                    @DateTime.Now.ToString("dddd, dd MMMM yyyy")
                </small>
            </div>
        </div>
        <div class="container-info">
            <p class="info-titulo mt-3">REQUISICIÓN DE MATERIALES</p>
        </div>
        <div class="requisicion-info">
            <div class="requisicion">
                <p class="info-body">Requisición:</p>
                <label class="info-body">-----------------</label>
            </div>
        </div>
    </div>

    <div class="container-formulario">
        <div class="seccion-1">
            <div class="formulario-input">
                <label>Departamento solicitante:</label>
                <input type="text" placeholder="Ej: Recursos Humanos" />
            </div>
            <div class="formulario-input">
                <label>Responsable:</label>
                <input type="text" placeholder="Nombre completo" />
            </div>
        </div>
        <div class="seccion-2">
            <div class="formulario-input">
                <label>Correo:</label>
                <input type="email" placeholder="correo@ejemplo.com" />
            </div>
            <div class="formulario-input">
                <label>Teléfono:</label>
                <input type="tel" placeholder="(222) 000-0000" />
            </div>
        </div>
    </div>

    <div class="container-formulario">
        <div class="seccion-completa">
            <div class="formulario-input">
                <label>Lugar de entrega:</label>
                <input type="text" placeholder="Dirección o área de entrega" />
            </div>
            <div class="formulario-input">
                <label>Uso específico del material:</label>
                <input type="text" placeholder="Describa el uso del material" />
            </div>
            <div class="formulario-input">
                <label>Justificación:</label>
                <textarea placeholder="Justifique la requisición" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="container-formulario">
        <div class="seccion-1">
            <div class="formulario-input">
                <label>Periodo del uso del material:</label>
                <input type="text" placeholder="Ej: Enero - Diciembre" />
            </div>
        </div>
        <div class="seccion-2">
            <div class="formulario-input">
                <label>Anual / Mensual:</label>
                <div class="formulario-opciones">
                    <label class="opcion">
                        <input type="radio" name="periodo" value="anual" />
                        <span>Anual</span>
                    </label>
                    <label class="opcion">
                        <input type="radio" name="periodo" value="mensual" />
                        <span>Mensual</span>
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="container-formulario">
        <div class="seccion-completa text-center">
            <div class="formulario-input">
                <label>¿Se encuentra programado en su presupuesto y su programa de adquisiciones?</label>
                <div class="formulario-opciones-presupuesto">
                    <label class="opcion">
                        <input type="radio" name="presupuesto" value="si" />
                        <span>Sí</span>
                    </label>
                    <label class="opcion">
                        <input type="radio" name="presupuesto" value="no" />
                        <span>No</span>
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>