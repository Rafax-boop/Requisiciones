<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario.AplicacionWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/main.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventario.AplicacionWeb.styles.css" asp-append-version="true" />
    <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
</head>
<body style="background-color: rgba(241, 235, 227, 0.05);">
    <header>
       <nav class="nav-bar glass-effect">
            <div class="nav-bar-user">
                <li class="nav-item dropdown list-unstyled">
                    <a class="nav-link dropdown-toggle p-1" href="#" id="navbarDropdown"
                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="line-md--account"></span>
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end glass-effect-pestaña" aria-labelledby="navbarDropdown">
                        <li class="dropdown-item-text px-3 py-2 text-center">
                            <small class="text-muted">Conectado como:</small>
                            <div class="fw-semibold" style="color: deeppink;">@User.Identity.Name</div>
                        </li>
                        <li class="user-close">
                            <a class="dropdown-item " href="@Url.Action("CerrarSesion", "Acceso")">
                                <span class="line-md--alert-circle-loop"></span>Cerrar Sesión
                            </a>
                        </li>
                    </ul>
                </li>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="glass-effect">
        <div class="footer-container">
            <img class="img-footer" src="~/img/familias-dif.png" alt="FamiliasDif" />
            <img class="img-footer" src="~/img/pensargrande.png" alt="PensarenGrande" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
