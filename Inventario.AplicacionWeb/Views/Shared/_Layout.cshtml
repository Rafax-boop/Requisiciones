<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario.AplicacionWeb</title>
    <link rel="icon" type="image/png" href="~/img/corazon.png" asp-append-version="true" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventario.AplicacionWeb.styles.css" asp-append-version="true" />
    <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
    @await RenderSectionAsync("Styles", required: false)
    <style>
        #page-loader {
            position: fixed;
            inset: 0;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 18px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(8px);
            transition: opacity 0.4s ease, visibility 0.4s ease;
        }

            #page-loader.oculto {
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
            }

            #page-loader img {
                width: 110px;
                animation: loader-pulse 1.1s ease-in-out infinite;
                filter: drop-shadow(0 0 18px rgba(255, 105, 180, 0.45));
            }

            #page-loader p {
                font-family: 'Outfit', sans-serif;
                font-size: 15px;
                font-weight: 500;
                color: #d63384;
                letter-spacing: 0.5px;
                margin: 0;
            }

        @@keyframes loader-pulse {

            0%,
            100% {
                transform: scale(1);
            }

            50% {
                transform: scale(1.12);
            }
        }
    </style>
</head>

<body style="background-color: rgba(241, 235, 227, 0.05);">

    <!-- PANTALLA DE CARGA GLOBAL -->
    <div id="page-loader">
        <img src="~/img/corazon.png" alt="Cargando..." />
        <p>Cargando...</p>
    </div>

    <header>
        <nav class="nav-bar glass-effect">
            <div class="nav-bar-user">
                <div class="nav-spacer">
                    <img src="~/img/corazon.png" alt="corazon" />
                </div>

                <li class="nav-buttons">
                    <a href="@Url.Action("Index", "Home")"
                       class="@(ViewData["Title"]?.ToString() == "Home Page" ? "active" : "")">
                        Inicio
                    </a>
                    @if (User.IsInRole("1") || User.IsInRole("3") || User.IsInRole("4") || User.IsInRole("5"))
                    {
                        <a href="@Url.Action("TablaRequisiciones", "Requisicion")"
                        class="@(ViewData["Title"]?.ToString() == "TablaRequisiciones" ? "active" : "")">
                            Requisición
                        </a>
                    }
                    @if (User.IsInRole("1") || User.IsInRole("6") || User.IsInRole("7") || User.IsInRole("5"))
                    {
                        <a href="@Url.Action("TablaRequisicionServicios", "Servicios")"
                        class="@(ViewData["Title"]?.ToString() == "TablaRequisicionServicios" || ViewData["Title"]?.ToString() == "FormularioRequisicionServicios" || ViewData["Title"]?.ToString() == "Requisiciones de Servicios" || ViewData["Title"]?.ToString() == "Formulario Requisición de Servicios" ? "active" : "")">
                            Servicios
                        </a>
                    }
                    @if (User.IsInRole("2") || User.IsInRole("5"))
                    {
                        <a href="@Url.Action("Index", "Almacen")"
                           class="@(ViewData["Title"]?.ToString() == "Almacen" ? "active" : "")">
                            Almacén
                        </a>
                    }
                </li>

                <div class="nav-bar-user">
                    <li class="nav-item dropdown list-unstyled">
                        <a class="nav-link dropdown-toggle p-1" href="#" id="navbarDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="line-md--account"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-effect-pestaña"
                            aria-labelledby="navbarDropdown">
                            <li class="dropdown-item-text px-3 py-2 text-center">
                                <small class="text-muted">Conectado como:</small>
                                <div class="fw-semibold" style="color: deeppink;">@User.Identity.Name</div>
                            </li>
                            <li class="user-close">
                                <a class="dropdown-item " href="@Url.Action("Logout", "Acceso")">
                                    <span class="line-md--alert-circle-loop"></span>Cerrar Sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <div class="home-bg">
            <div class="orbe orbe-1"></div>
            <div class="orbe orbe-2"></div>
            <div class="orbe orbe-3"></div>
            <div class="orbe orbe-4"></div>
        </div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="glass-effect">
        <div class="footer-container">
            <img class="img-footer" src="~/img/familias-dif.png" alt="FamiliasDif" />
            <img class="img-footer" src="~/img/pensargrande.png" alt="PensarenGrande" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ---- Pantalla de carga ----
        (function () {
            var loader = document.getElementById('page-loader');

            function ocultarLoader() {
                if (loader) loader.classList.add('oculto');
            }
            if (document.readyState === 'complete') {
                ocultarLoader();
            } else {
                window.addEventListener('load', ocultarLoader);
            }

            document.addEventListener('click', function (e) {
                var link = e.target.closest('a[href]');
                if (!link) return;
                var href = link.getAttribute('href');
                if (!href || href === '#' || href.startsWith('javascript') || href.startsWith('mailto')) return;
                if (link.dataset.bsToggle || link.dataset.bsDismiss) return;
                if (loader) loader.classList.remove('oculto');
            });

            document.addEventListener('submit', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('no-loader')) {
                    return;
                }
                if (e.target && e.target.checkValidity && !e.target.checkValidity()) {
                    return;
                }
                if (loader) loader.classList.remove('oculto');
            });
        })();

        @if (TempData["MensajeExito"] != null)
        {
                    <text>
                    window.addEventListener('load', function () {
                        @if (TempData["FolioCreado"] != null)
                        {
                                    <text>
                                    // Modal ESPECIAL para CREAR Requisición con FOLIO
                                    Swal.fire({
                                        icon: 'success',
                                        title: '¡Requisición Creada!',
                                        html: '@Html.Raw(TempData["MensajeExito"])<br>' +
                                              '<div style="font-size: 1.3em; font-weight: bold; color: #d63384; margin-top: 10px;">' +
                                              '@TempData["FolioCreado"]</div>',
                                        confirmButtonColor: '#d63384',
                                        confirmButtonText: 'Ver en Tabla',
                                        allowOutsideClick: false,
                                        timer: 6000
                                    });
                                    </text>
                        }
                        else
                        {
                                    <text>
                                    Swal.fire({
                                        icon: 'success',
                                        title: '¡Listo!',
                                        text: '@Html.Raw(TempData["MensajeExito"])',
                                        confirmButtonColor: '#d63384',
                                        confirmButtonText: 'Aceptar',
                                        timer: 3500,
                                        timerProgressBar: true
                                    });
                                    </text>
                        }
                    });
                    </text>
        }
        @if (TempData["MensajeError"] != null)
        {
                <text>
                    window.addEventListener('load', function () {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: '@Html.Raw(TempData["MensajeError"])',
                            confirmButtonColor: '#d63384',
                            confirmButtonText: 'Aceptar'
                        });
                        });
                </text>
        }
    </script>
</body>

</html>
