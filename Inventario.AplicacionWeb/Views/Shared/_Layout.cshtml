<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventario.AplicacionWeb</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/main.css"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Inventario.AplicacionWeb.styles.css" asp-append-version="true" />
    <script src="https://code.iconify.design/iconify-icon/3.0.0/iconify-icon.min.js"></script>
</head>
<body style="background-color: rgba(241, 235, 227, 0.05);">
    <header>
       <nav class="nav-bar glass-effect">
            <div class="nav-bar-user">
                <div class="nav-spacer">
                    <img src="~/img/corazon.png" alt="corazon" />
                </div>

                <li class="nav-buttons">
                    <a href="@Url.Action("Index", "Home")"
                       class="@(ViewData["Title"]?.ToString() == "Home Page" ? "active" : "")">
                        Inicio
                    </a>
                    <a href="@Url.Action("TablaRequisiciones", "Requisicion")"
                       class="@(ViewData["Title"]?.ToString() == "TablaRequisiciones" ? "active" : "")">
                        Requisición
                    </a>
                    <a href="#">Almacén</a>
                    <a href="#">Reportes</a>
                </li>

                <div class="nav-bar-user">
                    <li class="nav-item dropdown list-unstyled">
                        <a class="nav-link dropdown-toggle p-1" href="#" id="navbarDropdown"
                           role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="line-md--account"></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end glass-effect-pestaña" aria-labelledby="navbarDropdown">
                            <li class="dropdown-item-text px-3 py-2 text-center">
                                <small class="text-muted">Conectado como:</small>
                                <div class="fw-semibold" style="color: deeppink;">@User.Identity.Name</div>
                            </li>
                            <li class="user-close">
                                <a class="dropdown-item " href="@Url.Action("Logout", "Acceso")">
                                    <span class="line-md--alert-circle-loop"></span>Cerrar Sesión
                                </a>
                            </li>
                        </ul>
                    </li>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <div class="home-bg">
            <div class="orbe orbe-1"></div>
            <div class="orbe orbe-2"></div>
            <div class="orbe orbe-3"></div>
            <div class="orbe orbe-4"></div>
        </div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="glass-effect">
        <div class="footer-container">
            <img class="img-footer" src="~/img/familias-dif.png" alt="FamiliasDif" />
            <img class="img-footer" src="~/img/pensargrande.png" alt="PensarenGrande" />
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/es.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
