@model List<Inventario.BLL.DTO.TablaApiHistorialDTO>
@{
    ViewData["Title"] = "Histórico Tabla API";
    var requisicionNum = Model.FirstOrDefault()?.Modelo?.NumeroRequisicion ?? "—";
}

@section Styles {
    <link rel="stylesheet" href="~/css/componentes/form-comun.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/financieros/editar-tabla-api.css" asp-append-version="true" />
}

<div class="mt-3 container tabla-api-editor-page">
    <div class="info-requisicion">
        <div class="fantasma"></div>
        <div class="container-info">
            <p class="info-titulo mt-3">Histórico Tabla API</p>
        </div>
        <div class="requisicion-info">
            <div class="requisicion">
                <p class="info-body">Requisición:</p>
                <label class="info-body">@requisicionNum</label>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="container-formulario mt-4">
            <p class="text-center text-muted">No hay versiones generadas para esta requisición.</p>
        </div>
    }
    else
    {
        <!-- Lista de versiones -->
        <div class="container-formulario mt-3">
            <div class="seccion-completa">
                <div class="table-responsive-container">
                    <table class="tabla-api-editor-grid">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Fecha generación</th>
                                <th>Usuario</th>
                                <th>Observación</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var h = Model[i];
                                <tr>
                                    <td>@(i + 1)</td>
                                    <td>@h.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@h.NombreUsuario</td>
                                    <td>@(h.Observacion ?? "—")</td>
                                    <td>
                                        <button class="btn boton-rosa btn-sm"
                                                onclick="verDetalle(@h.IdHistorial)"
                                                title="Ver detalle">
                                            <i class="bi bi-eye"></i> Ver
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Modales de detalle por versión -->
        @foreach (var h in Model)
        {
            var m = h.Modelo;
            if (m == null) continue;

            <div class="modal fade" id="modal-@h.IdHistorial" tabindex="-1">
                <div class="modal-dialog modal-xl modal-dialog-scrollable">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">
                                Versión del @h.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
                                — @h.NombreUsuario
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">

                            <!-- Datos generales -->
                            <div class="container-formulario">
                                <div class="seccion-1">
                                    <div class="formulario-input">
                                        <label>Fecha de elaboración</label>
                                        <input type="text" value="@m.FechaElaboracion" readonly />
                                    </div>
                                    <div class="formulario-input">
                                        <label>Ejercicio</label>
                                        <input type="text" value="@m.Ejercicio" readonly />
                                    </div>
                                    <div class="formulario-input">
                                        <label>Área solicitante (clave)</label>
                                        <input type="text" value="@m.AreaSolicitanteClave" readonly />
                                    </div>
                                    <div class="formulario-input">
                                        <label>Área solicitante (nombre)</label>
                                        <input type="text" value="@m.AreaSolicitanteNombre" readonly />
                                    </div>
                                </div>
                                <div class="seccion-2">
                                    <div class="formulario-input">
                                        <label>Número de requisición</label>
                                        <input type="text" value="@m.NumeroRequisicion" readonly />
                                    </div>
                                    <div class="formulario-input">
                                        <label>Oficio suficiencia / autorización</label>
                                        <input type="text" value="@m.OficioSuficiencia" readonly />
                                    </div>
                                    <div class="formulario-input">
                                        <label>Contrato asociado</label>
                                        <input type="text" value="@m.ContratoAsociado" readonly />
                                    </div>
                                </div>
                            </div>

                            <div class="container-formulario">
                                <div class="seccion-completa">
                                    <div class="formulario-input">
                                        <label>Descripción del bien o servicio</label>
                                        <textarea rows="2" readonly>@m.DescripcionBienServicio</textarea>
                                    </div>
                                    <div class="formulario-input">
                                        <label>Justificación</label>
                                        <textarea rows="2" readonly>@m.Justificacion</textarea>
                                    </div>
                                    <div class="formulario-input">
                                        <label>Comentarios</label>
                                        <textarea rows="2" readonly>@m.Comentarios</textarea>
                                    </div>
                                </div>
                            </div>

                            <!-- Partidas -->
                            <div class="container-formulario">
                                <div class="seccion-completa">
                                    <h6 class="text-center mb-2">Partidas</h6>
                                    <div class="table-responsive-container">
                                        <table class="tabla-api-editor-grid">
                                            <thead>
                                                <tr>
                                                    <th>No.</th>
                                                    <th>UA</th>
                                                    <th>Clave municipio</th>
                                                    <th>Importe solicitado</th>
                                                    <th>Fuente</th>
                                                    <th>PP</th>
                                                    <th>Componente</th>
                                                    <th>Actividad</th>
                                                    <th>Objeto del gasto</th>
                                                    <th>Importe autorizado</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var p in m.Partidas)
                                                {
                                                    <tr>
                                                        <td>@p.Numero</td>
                                                        <td>@p.Ua</td>
                                                        <td>@p.ClaveMunicipio</td>
                                                        <td>@p.ImporteSolicitado</td>
                                                        <td>@p.FuenteFinanciamiento</td>
                                                        <td>@p.Pp</td>
                                                        <td>@p.Componente</td>
                                                        <td>@p.Actividad</td>
                                                        <td>@p.ObjetoGasto</td>
                                                        <td>@p.ImporteAutorizado</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Totales -->
                            <div class="container-formulario">
                                <div class="seccion-1">
                                    <div class="formulario-input">
                                        <label>Total solicitado</label>
                                        <input type="text" value="@m.TotalSolicitado" readonly />
                                    </div>
                                </div>
                                <div class="seccion-2">
                                    <div class="formulario-input">
                                        <label>Total autorizado</label>
                                        <input type="text" value="@m.TotalAutorizado" readonly />
                                    </div>
                                </div>
                            </div>

                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn boton-gris" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Volver -->
    <div class="container-formulario mt-4">
        <div class="seccion-completa text-center editor-actions">
            <a class="btn boton-gris btn-lg" href="@Url.Action("TablaFinancieros", "Financieros")">Volver</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalle(idHistorial) {
            const modal = new bootstrap.Modal(document.getElementById('modal-' + idHistorial));
            modal.show();
        }
    </script>
}