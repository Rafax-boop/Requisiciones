@model Inventario.AplicacionWeb.Models.ViewModels.HistorialDocumentosVM
@{
    ViewData["Title"] = "Histórico de Documentos";
    var numReq = Model.NumRequisicion ?? "—";
}

@section Styles {
    <link rel="stylesheet" href="~/css/componentes/form-comun.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/formulario-requisiciones.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/financieros/editar-tabla-api.css" asp-append-version="true" />
    <style>
        .tab-hist-btns {
            display: flex;
            gap: 6px;
            margin-bottom: 22px;
            border-bottom: 2px solid var(--slate-200);
            padding: 0 4px;
        }
        .tab-hist-btn {
            padding: 12px 22px;
            border: none;
            background: transparent;
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--slate-500);
            cursor: pointer;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            transition: all .25s var(--ease-premium);
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .tab-hist-btn i { font-size: 14px; }
        .tab-hist-btn:hover { color: var(--rosa-400); }
        .tab-hist-btn.activo {
            color: var(--rosa-500);
            border-color: var(--rosa-500);
        }
        .tab-hist-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 22px;
            height: 22px;
            padding: 0 7px;
            border-radius: 999px;
            background: var(--slate-100);
            color: var(--slate-600);
            font-size: 11px;
            font-weight: 700;
        }
        .tab-hist-btn.activo .tab-hist-count {
            background: var(--rosa-100);
            color: var(--rosa-500);
        }
        .tab-hist-panel { display: none; animation: fadeIn .25s ease; }
        .tab-hist-panel.activo { display: block; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

        .hist-empty {
            text-align: center;
            padding: 48px 20px;
            color: var(--slate-500);
            font-size: 14px;
        }
        .hist-empty i {
            display: block;
            font-size: 38px;
            color: var(--slate-300);
            margin-bottom: 10px;
        }

        /* Scroll horizontal para tablas dentro de los modales */
        .modal .table-responsive-container {
            width: 100%;
            max-width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        .modal .tabla-api-editor-grid {
            min-width: 1100px;
        }
        .modal-body-premium { overflow-x: hidden; }

        /* Sub-encabezados dentro de los modales */
        .hist-modal-section-title {
            font-family: var(--font-display);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--rosa-500);
            margin: 4px 0 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--rosa-100);
        }
    </style>
}

<div class="mt-3 container tabla-api-editor-page">
    <div class="info-requisicion">
        <div class="fantasma"></div>
        <div class="container-info">
            <p class="info-titulo mt-3">Histórico de Documentos</p>
        </div>
        <div class="requisicion-info">
            <div class="requisicion">
                <p class="info-body">Requisición:</p>
                <label class="info-body">@numReq</label>
            </div>
        </div>
    </div>

    <div class="container-formulario mt-3">
        <div class="seccion-completa">

            <div class="tab-hist-btns">
                <button type="button" class="tab-hist-btn activo" id="btnTabApi" onclick="cambiarTab('api')">
                    <i class="fa-solid fa-table"></i>
                    <span>Tabla API</span>
                    <span class="tab-hist-count">@Model.HistorialTablaApi.Count</span>
                </button>
                <button type="button" class="tab-hist-btn" id="btnTabPedido" onclick="cambiarTab('pedido')">
                    <i class="fa-solid fa-file-invoice-dollar"></i>
                    <span>Pedido de Compra</span>
                    <span class="tab-hist-count">@Model.HistorialPedido.Count</span>
                </button>
            </div>

            <div class="tab-hist-panel activo" id="panelApi">
                @if (!Model.HistorialTablaApi.Any())
                {
                    <div class="hist-empty">
                        <i class="fa-solid fa-folder-open"></i>
                        No hay versiones generadas para esta requisición.
                    </div>
                }
                else
                {
                    <div class="table-responsive-container">
                        <table class="tabla-api-editor-grid">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Fecha generación</th>
                                    <th>Usuario</th>
                                    <th>Observación</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.HistorialTablaApi.Count; i++)
                                {
                                    var h = Model.HistorialTablaApi[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@h.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@h.NombreUsuario</td>
                                        <td>@(h.Observacion ?? "—")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn boton-rosa btn-sm"
                                                    onclick="verDetalleApi(@h.IdHistorial)"
                                                    title="Ver detalle">
                                                <i class="fa-solid fa-eye"></i> Ver
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="tab-hist-panel" id="panelPedido">
                @if (!Model.HistorialPedido.Any())
                {
                    <div class="hist-empty">
                        <i class="fa-solid fa-folder-open"></i>
                        No hay pedidos generados para esta requisición.
                    </div>
                }
                else
                {
                    <div class="table-responsive-container">
                        <table class="tabla-api-editor-grid">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Fecha generación</th>
                                    <th>Usuario</th>
                                    <th>Nº Pedido</th>
                                    <th>Proveedor</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.HistorialPedido.Count; i++)
                                {
                                    var h = Model.HistorialPedido[i];
                                    <tr>
                                        <td>@(i + 1)</td>
                                        <td>@h.FechaGeneracion?.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@h.NombreUsuario</td>
                                        <td>@(h.Modelo?.NumeroPedido ?? "—")</td>
                                        <td>@(h.Modelo?.ProveedorNombre ?? "—")</td>
                                        <td class="text-center">
                                            <button type="button" class="btn boton-rosa btn-sm"
                                                    onclick="verDetallePedido(@h.IdHistorial)"
                                                    title="Ver detalle">
                                                <i class="fa-solid fa-eye"></i> Ver
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

        </div>
    </div>

    <div class="container-formulario mt-4">
        <div class="seccion-completa text-center editor-actions">
            <a class="btn boton-gris btn-lg" href="@Url.Action("TablaFinancieros", "Financieros")">
                <i class="fa-solid fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>


<!-- ═══════════════════════════════════════════════════════════ -->
<!-- MODALES TABLA API                                          -->
<!-- ═══════════════════════════════════════════════════════════ -->
@foreach (var h in Model.HistorialTablaApi)
{
    var m = h.Modelo;
    if (m == null) continue;

    <div class="modal fade" id="modal-api-@h.IdHistorial" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content modal-premium">
                <div class="modal-header modal-header-premium">
                    <div>
                        <h5 class="modal-title modal-titulo-premium">
                            <i class="fa-solid fa-table"></i> Tabla API
                        </h5>
                        <p class="modal-subtitulo-premium">
                            @h.FechaGeneracion.ToString("dd/MM/yyyy HH:mm") · @h.NombreUsuario
                        </p>
                    </div>
                    <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div class="modal-body modal-body-premium">

                    <p class="hist-modal-section-title">Datos generales</p>
                    <div class="container-formulario">
                        <div class="seccion-1">
                            <div class="formulario-input">
                                <label>Fecha de elaboración</label>
                                <input type="text" value="@m.FechaElaboracion" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Ejercicio</label>
                                <input type="text" value="@m.Ejercicio" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Área solicitante (clave)</label>
                                <input type="text" value="@m.AreaSolicitanteClave" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Área solicitante (nombre)</label>
                                <input type="text" value="@m.AreaSolicitanteNombre" readonly />
                            </div>
                        </div>
                        <div class="seccion-2">
                            <div class="formulario-input">
                                <label>Número de requisición</label>
                                <input type="text" value="@m.NumeroRequisicion" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Oficio suficiencia / autorización</label>
                                <input type="text" value="@m.OficioSuficiencia" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Contrato asociado</label>
                                <input type="text" value="@m.ContratoAsociado" readonly />
                            </div>
                        </div>
                    </div>

                    <p class="hist-modal-section-title">Descripción y justificación</p>
                    <div class="container-formulario">
                        <div class="seccion-completa">
                            <div class="formulario-input">
                                <label>Descripción del bien o servicio</label>
                                <textarea rows="2" readonly>@m.DescripcionBienServicio</textarea>
                            </div>
                            <div class="formulario-input">
                                <label>Justificación</label>
                                <textarea rows="2" readonly>@m.Justificacion</textarea>
                            </div>
                            <div class="formulario-input">
                                <label>Comentarios</label>
                                <textarea rows="2" readonly>@m.Comentarios</textarea>
                            </div>
                        </div>
                    </div>

                    <p class="hist-modal-section-title">Partidas</p>
                    <div class="container-formulario">
                        <div class="seccion-completa">
                            <div class="table-responsive-container">
                                <table class="tabla-api-editor-grid">
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>UA</th>
                                            <th>Región</th>
                                            <th>Clave municipio</th>
                                            <th>Importe solicitado</th>
                                            <th>Fuente</th>
                                            <th>PP</th>
                                            <th>Componente</th>
                                            <th>Actividad</th>
                                            <th>Objeto del gasto</th>
                                            <th>Importe autorizado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in m.Partidas)
                                        {
                                            <tr>
                                                <td>@p.Numero</td>
                                                <td>@p.Ua</td>
                                                <td>@p.Region</td>
                                                <td>@p.ClaveMunicipio</td>
                                                <td>@p.ImporteSolicitado</td>
                                                <td>@p.FuenteFinanciamiento</td>
                                                <td>@p.Pp</td>
                                                <td>@p.Componente</td>
                                                <td>@p.Actividad</td>
                                                <td>@p.ObjetoGasto</td>
                                                <td>@p.ImporteAutorizado</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <p class="hist-modal-section-title">Totales</p>
                    <div class="container-formulario">
                        <div class="seccion-1">
                            <div class="formulario-input">
                                <label>Total solicitado</label>
                                <input type="text" value="@m.TotalSolicitado" readonly />
                            </div>
                        </div>
                        <div class="seccion-2">
                            <div class="formulario-input">
                                <label>Total autorizado</label>
                                <input type="text" value="@m.TotalAutorizado" readonly />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn boton-gris" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}


<!-- ═══════════════════════════════════════════════════════════ -->
<!-- MODALES PEDIDO DE COMPRA                                   -->
<!-- ═══════════════════════════════════════════════════════════ -->
@foreach (var h in Model.HistorialPedido)
{
    var m = h.Modelo;
    if (m == null) continue;
    var MX = new System.Globalization.CultureInfo("es-MX");

    <div class="modal fade" id="modal-pedido-@h.IdHistorial" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content modal-premium">
                <div class="modal-header modal-header-premium">
                    <div>
                        <h5 class="modal-title modal-titulo-premium">
                            <i class="fa-solid fa-file-invoice-dollar"></i> Pedido de Compra
                        </h5>
                        <p class="modal-subtitulo-premium">
                            @h.FechaGeneracion?.ToString("dd/MM/yyyy HH:mm") · @h.NombreUsuario
                        </p>
                    </div>
                    <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div class="modal-body modal-body-premium">

                    <p class="hist-modal-section-title">Proveedor</p>
                    <div class="container-formulario">
                        <div class="seccion-1">
                            <div class="formulario-input">
                                <label>Proveedor adjudicado</label>
                                <input type="text" value="@m.ProveedorNombre" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>R.F.C.</label>
                                <input type="text" value="@m.ProveedorRfc" readonly />
                            </div>
                        </div>
                        <div class="seccion-2">
                            <div class="formulario-input">
                                <label>Dirección</label>
                                <input type="text" value="@m.ProveedorDireccion" readonly />
                            </div>
                        </div>
                    </div>

                    <p class="hist-modal-section-title">Datos del pedido</p>
                    <div class="container-formulario">
                        <div class="seccion-1">
                            <div class="formulario-input">
                                <label>Nº de Pedido</label>
                                <input type="text" value="@m.NumeroPedido" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Departamento solicitante</label>
                                <input type="text" value="@m.Departamento" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Responsable</label>
                                <input type="text" value="@m.Responsable" readonly />
                            </div>
                        </div>
                        <div class="seccion-2">
                            <div class="formulario-input">
                                <label>Lugar de entrega</label>
                                <input type="text" value="@m.LugarEntrega" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Tiempo de entrega</label>
                                <input type="text" value="@m.TiempoEntrega" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Condiciones de pago</label>
                                <input type="text" value="@m.CondicionesPago" readonly />
                            </div>
                        </div>
                    </div>

                    <p class="hist-modal-section-title">Artículos</p>
                    <div class="container-formulario">
                        <div class="seccion-completa">
                            <div class="table-responsive-container">
                                <table class="tabla-api-editor-grid">
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>Clave</th>
                                            <th>Descripción</th>
                                            <th>Cantidad</th>
                                            <th>Unidad</th>
                                            <th>Precio unitario</th>
                                            <th>Precio total</th>
                                            <th>IVA</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in m.Partidas)
                                        {
                                            decimal precioTotal = p.PrecioUnitario * p.Cantidad;
                                            <tr>
                                                <td>@p.Numero</td>
                                                <td>@p.Clave</td>
                                                <td>@p.Descripcion</td>
                                                <td>@p.Cantidad.ToString("N0")</td>
                                                <td>@p.UnidadMedida</td>
                                                <td>@p.PrecioUnitario.ToString("C2", MX)</td>
                                                <td>@precioTotal.ToString("C2", MX)</td>
                                                <td>@(p.TieneIva ? "Sí" : "No")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <p class="hist-modal-section-title">Totales</p>
                    <div class="container-formulario">
                        <div class="seccion-1">
                            <div class="formulario-input">
                                <label>Suma</label>
                                <input type="text" value="@m.Suma.ToString("C2", MX)" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>I.V.A. 16%</label>
                                <input type="text" value="@m.Iva.ToString("C2", MX)" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Descuento</label>
                                <input type="text" value="@m.Descuento.ToString("C2", MX)" readonly />
                            </div>
                        </div>
                        <div class="seccion-2">
                            <div class="formulario-input">
                                <label>Subtotal</label>
                                <input type="text" value="@m.Subtotal.ToString("C2", MX)" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Ret. 5 al millar</label>
                                <input type="text" value="@m.Retencion.ToString("C2", MX)" readonly />
                            </div>
                            <div class="formulario-input">
                                <label>Total</label>
                                <input type="text" value="@m.Total.ToString("C2", MX)" readonly />
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn boton-gris" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {

            window.cambiarTab = function (tab) {
                var esApi = tab === 'api';
                document.getElementById('btnTabApi').classList.toggle('activo', esApi);
                document.getElementById('btnTabPedido').classList.toggle('activo', !esApi);
                document.getElementById('panelApi').classList.toggle('activo', esApi);
                document.getElementById('panelPedido').classList.toggle('activo', !esApi);
            };

            window.verDetalleApi = function (id) {
                new bootstrap.Modal(document.getElementById('modal-api-' + id)).show();
            };

            window.verDetallePedido = function (id) {
                new bootstrap.Modal(document.getElementById('modal-pedido-' + id)).show();
            };

        })();
    </script>
}
