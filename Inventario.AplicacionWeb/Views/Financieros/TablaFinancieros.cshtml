@using Inventario.AplicacionWeb.Models.ViewModels
@using Inventario.AplicacionWeb.Utilidades
@model VMTablaRequisiciones
@{
    ViewData["Title"] = "Presupuesto";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/tabla-requisiciones.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="tabla-requi-page"
     data-url-notif-snapshot="@Url.Action("SnapshotIdsPorTab", "Financieros")"
     data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")"
     data-url-ver-pdf-requi="@Url.Action("VerParaPdf", "Requisicion")"
     data-url-ver-pdf-servicio="@Url.Action("VerParaPdf", "Servicios")"
     data-url-usuarios-financieros="@Url.Action("ObtenerUsuariosFinancieros", "Financieros")"
     data-url-asignar=" @Url.Action("AsignarRequisicion", "Financieros")"
     data-url-atender="@Url.Action("Atender", "Financieros")"
     data-url-rechazar="@Url.Action("RechazarRequisicion", "Requisicion")"
     data-url-obtener-progreso="@Url.Action("ObtenerProgresoRequisicion", "Requisicion")"
     data-url-finalizar-expediente="@Url.Action("FinalizarRequisicion", "Financieros")"
     data-url-obtener-docs-proveedor="@Url.Action("ObtenerDocumentosProveedor", "Requisicion")"
     data-url-rebotar-documentos="@Url.Action("RebotarDocumentos", "Requisicion")"
     data-url-descargar-tabla-api="@Url.Action("DescargarTablaApi", "Financieros")">
    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Requisiciones </h1>
            <p class="tabla-requi-subtitulo">Gestión y seguimiento de requisiciones</p>
        </div>
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>Nº Requisición</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly style="width:100%;" />
                <button type="button" id="btnLimpiarFecha"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha" onclick="limpiarFecha()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
        <div class="filtro-grupo">
            <label>Estado</label>
            <select id="filtroEstado" class="filtro-select-almacen">
                <option value="">Todos los estados</option>
                @foreach (var e in Model.Estatus)
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
    </div>

    <nav class="almacen-tabs">
        <button type="button" class="almacen-tabs-btn activo" data-tab="principal">En seguimiento</button>
        <button type="button" class="almacen-tabs-btn" data-tab="autorizadas">Requisiciones autorizadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="rechazadas">Requisiciones rechazadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="procesopago">Proceso de pago</button>
    </nav>

    @{
        var numColsReq = 8;
        if (User.IsInRole("8")) numColsReq++;
        if (User.IsInRole("9") || User.IsInRole("8")) numColsReq++;
        var requisicionesPrincipal = Model.Requisiciones.Where(r => r.IdEstatus == 13 || r.IdEstatus == 14).ToList();
        var requisicionesAutorizadas = Model.Requisiciones.Where(r => r.IdEstatus == 15).ToList();
        var requisicionesRechazadas = Model.Requisiciones.Where(r => r.IdEstatus == 5).ToList();
        var requisicionesProcesoPago = Model.Requisiciones.Where(r => r.IdEstatus == 17).ToList();
    }

    <!-- Pestaña En seguimiento -->
    <div id="tab-principal" class="almacen-tab-panel activo">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesPrincipal">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Items</th>
                        <th>Estado</th>
                        @if (User.IsInRole("8"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("9") || User.IsInRole("8"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxPrincipal = 0;
                    }
                    @foreach (var item in requisicionesPrincipal)
                    {
                        idxPrincipal++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi" data-requi-servicio="@(item.RequiServicio?.ToString().ToLower() ?? "false")">
                            <td style="text-align:center">@idxPrincipal</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("8"))
                            {
                                <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                            }
                            @if (User.IsInRole("9") || User.IsInRole("8"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorP = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorP">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <div class="acciones-grupo" style="justify-content:center">
                                        @if (!User.IsInRole("9"))
                                        {
                                            <button class="btn-accion btn-ver" title="Ver detalle"
                                                    onclick="verDetalle(@item.IdRequi, 'readonly')">
                                                <i class="fa-solid fa-eye"></i>
                                            </button>
                                        }
                                        <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                            <i class="fa-solid fa-file-pdf"></i>
                                        </button>
                                        @if (User.IsInRole("8") && item.IdEstatus == 13)
                                        {
                                            <button class="btn-accion" title="Asignar Requisición" onclick="abrirModalAsignar(@item.IdRequi)">
                                                <i class="fa-solid fa-clipboard-user"></i>
                                            </button>
                                        }
                                        @if (User.IsInRole("9") && item.IdEstatus == 14)
                                        {
                                            <button class="btn-accion" title="Atender" onclick="atenderRequisicion(@item.IdRequi)">
                                                <i class="fa-solid fa-hand-holding"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (fase, esTerminal, esMod, progress) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progress)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisición Capturada</strong>
                                                <span>Emisión @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotización</div>
                                            <div class="step-tooltip">
                                                <strong>Cotización / Presupuesto</strong>
                                                <span>@(fase >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 3 ? (esMod ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esMod ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@(esMod ? "A Modificar" : "Trámite")</div>
                                            <div class="step-tooltip">
                                                <strong>@(esMod ? "Modificación" : "Trámite Operativo")</strong>
                                                <span>@(esMod ? "Regresada para cambios" : (fase >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(fase >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(fase >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesPrincipal.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones en seguimiento</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones autorizadas -->
    <div id="tab-autorizadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesAutorizadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th>Items</th>
                        <th>Estado</th>
                        @if (User.IsInRole("8"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("9") || User.IsInRole("8"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxAutorizadas = 0;
                    }
                    @foreach (var item in requisicionesAutorizadas)
                    {
                        idxAutorizadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi" data-requi-servicio="@(item.RequiServicio?.ToString().ToLower() ?? "false")">
                            <td style="text-align:center">@idxAutorizadas</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("8"))
                            {
                                <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                            }
                            @if (User.IsInRole("9") || User.IsInRole("8"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorA = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorA">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (faseA, esTerminalA, esModA, progA) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progA)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisición Capturada</strong>
                                                <span>Emisión @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotización</div>
                                            <div class="step-tooltip">
                                                <strong>Cotización / Presupuesto</strong>
                                                <span>@(faseA >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 3 ? (esModA ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esModA ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@(esModA ? "A Modificar" : "Trámite")</div>
                                            <div class="step-tooltip">
                                                <strong>@(esModA ? "Modificación" : "Trámite Operativo")</strong>
                                                <span>@(esModA ? "Regresada para cambios" : (faseA >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(faseA >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(faseA >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesAutorizadas.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones autorizadas</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionAutorizadas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones rechazadas -->
    <div id="tab-rechazadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesRechazadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th>Items</th>
                        <th>Estado</th>
                        @if (User.IsInRole("8"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("9") || User.IsInRole("8"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxRechazadas = 0;
                    }
                    @foreach (var item in requisicionesRechazadas)
                    {
                        idxRechazadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi" data-requi-servicio="@(item.RequiServicio?.ToString().ToLower() ?? "false")">
                            <td style="text-align:center">@idxRechazadas</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("8"))
                            {
                                <td>@(item.NombreAsignado ?? "Sin asignar")</td>
                            }
                            @if (User.IsInRole("9") || User.IsInRole("8"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorR = item.DiasAsignado <= 5 ? "badge-semaforo-verde" : (item.DiasAsignado <= 8 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorR">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF" onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    <div class="p-3 text-center" style="border:1px solid #fecaca;border-radius:10px;background:#fef2f2;">
                                        <p class="mb-1" style="color:#b91c1c;font-weight:700;"><i class="fa-solid fa-circle-xmark"></i> Requisición rechazada</p>
                                        <p class="text-muted small mb-2">El folio ya no está en seguimiento activo.</p>
                                        <button type="button" class="btn btn-sm" style="border:1px solid #fecaca;background:white;color:#b91c1c;" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                            <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesRechazadas.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones rechazadas</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRechazadas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Tab proceso de pago -->
    <div id="tab-procesopago" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesProcesoPago">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Items</th>
                        <th>Estado</th>
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxProcesoPago = 0;
                    }
                    @foreach (var item in requisicionesProcesoPago)
                    {
                        idxProcesoPago++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi"
                            data-requi-servicio="@item.RequiServicio.ToString().ToLower()">
                            <td style="text-align:center">@idxProcesoPago</td>
                            <td>@item.NumRequi</td>
                            <td>@item.FechaEmision</td>
                            <td>@item.Departamento</td>
                            <td>@item.Responsable</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver expediente"
                                            onclick="verExpedienteFinancieros(@item.IdRequi)">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </button>
                                    <button class="btn-accion btn-pdf" title="Exportar a PDF"
                                            onclick="verPdf(@item.IdRequi)">
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesProcesoPago.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="8" class="text-center">No hay requisiciones en proceso de pago</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionProcesoPago" class="almacen-paginacion"></div>
        </div>
    </div>
</div>

<!-- Modal expediente financieros -->
<div class="modal" id="modalExpedienteFinancieros" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium">Expediente de Requisición</h5>
                    <p class="modal-subtitulo-premium" id="expFinSubtitulo">Cargando...</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body modal-body-premium">

                <div class="row mb-3">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Actividad:</label>
                            <select id="expFinActividad" class="form-select select2" disabled>
                                <option value="">--</option>
                                @foreach (var act in Model.ListaActividades)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Fuente de Financiamiento:</label>
                            <select id="expFinFf" class="form-select select2" disabled>
                                <option value="">--</option>
                                <option value="1">Federal</option>
                                <option value="2">Estatal</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Tipo de Programa:</label>
                            <select id="expFinTipoPrograma" class="form-select select2" disabled>
                                <option value="">--</option>
                                <option value="1">Prioritario</option>
                                <option value="2">Adicional</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Municipio:</label>
                            <select id="expFinMunicipio" class="form-select select2" disabled>
                                <option value="">--</option>
                                @foreach (var m in Model.ListaMunicipios)
                                {
                                    <option value="@m.Value">@m.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-responsive-container">
                    <table class="tabla-requisiciones">
                        <thead>
                            <tr>
                                <th>Nº Partida</th>
                                <th>Cantidad</th>
                                <th>Unidad Medida</th>
                                <th>Descripción</th>
                                <th>Descripción Detallada</th>
                            </tr>
                        </thead>
                        <tbody id="expFinTablaBody"></tbody>
                    </table>
                </div>

                <div id="expFinSeccionFotos" style="display:none; margin-top:16px;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:8px;">
                        <i class="fa-solid fa-images"></i> Fotos de referencia
                    </p>
                    <div id="expFinGaleriaFotos" style="display:flex;flex-wrap:wrap;gap:10px;"></div>
                </div>

                <div id="expFinArchivosBase" style="margin-top:16px;"></div>

                <div style="margin-top:16px;">
                    <div class="formulario-input">
                        <label>Observaciones de financieros</label>
                        <textarea id="expFinObservaciones" class="form-control" rows="3"
                                  readonly placeholder="Sin observaciones..."></textarea>
                    </div>
                </div>

                <div id="expFinArchivosFinancieros" style="display:none; margin-top:16px;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:10px;">
                        <i class="fa-solid fa-folder-open"></i> Documentos financieros
                    </p>
                    <div id="expFinGrupoSiaf" style="margin-bottom:12px;"></div>
                    <div id="expFinGrupoTablaApi" style="margin-bottom:12px;"></div>
                    <div id="expFinGrupoNumeroApi"></div>
                </div>

                <!-- Documentos del proveedor -->
                <div id="expFinDocumentosProveedor" style="margin-top:20px; display:none;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:12px;">
                        <i class="fa-solid fa-file-contract"></i> Documentos del proveedor
                    </p>
                    <div id="expFinChecklistDocs" style="display:flex; flex-direction:column; gap:8px;"></div>
                </div>

                <!-- Botones -->
                <div style="margin-top:20px; display:flex; justify-content:flex-end; gap:10px;">
                    <button type="button" class="btn btn-danger" onclick="rebotarDocumentos()">
                        <i class="fa-solid fa-rotate-left"></i> Rebotar documentos
                    </button>
                    <button type="button" class="btn boton-rosa" onclick="finalizarExpediente()">
                        <i class="fa-solid fa-circle-check"></i> Finalizar
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal ver requisición (misma estructura que Requisición y Almacén) -->
<div class="modal" id="modalDetalle" tabindex="-1" aria-labelledby="detalleLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="detalleLabel">Artículos de la Requisición</h5>
                    <p class="modal-subtitulo-premium">Detalle de partidas solicitadas</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Sección selects (siempre readonly aquí, se habilitan solo en atender) -->
            <div style="display:none; margin-top:20px;" class="px-4 seccionAtender">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Actividad:</label>
                            <select id="actividadSeleccionada" class="form-select select2">
                                <option value="">-- Selecciona actividad --</option>
                                @foreach (var act in Model.ListaActividades)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Fuente de Financiamiento:</label>
                            <select id="ffSelect" class="form-select select2">
                                <option value="">-- Selecciona Fuente de Financiamiento --</option>
                                <option value="1">Federal</option>
                                <option value="2">Estatal</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Tipo de Programa:</label>
                            <select id="tipoProgramaSelect" class="form-select select2">
                                <option value="">-- Selecciona el Tipo de Programa --</option>
                                <option value="1">Prioritario</option>
                                <option value="2">Adicional</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Municipio:</label>
                            <select id="municipio" class="form-select select2">
                                <option value="">-- Selecciona municipio --</option>
                                @foreach (var act in Model.ListaMunicipios)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body modal-body-premium">
                <div class="table-responsive-container">
                    <table class="tabla-requisiciones" id="tablaModalDetalle">
                        <thead>
                            <tr>
                                <th>Nº Partida</th>
                                <th>Cantidad</th>
                                <th>Unidad Medida</th>
                                <th>Descripción</th>
                                <th>Descripción Detallada</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalle"></tbody>
                    </table>
                </div>

                <div id="seccionFotosDetalle" style="display:none; margin-top:16px;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:8px;">
                        <i class="fa-solid fa-images"></i> Fotos de referencia
                    </p>
                    <div id="galeriaFotosDetalle" style="display:flex; flex-wrap:wrap; gap:10px;"></div>
                </div>

                <!-- Archivos subidos (readonly) -->
                <div id="contenedorArchivosReadonly"></div>

                <!-- Sección atender: observaciones + botones (solo rol 9) -->
                <div class="seccionAtender" style="display:none; margin-top:20px;">
                    <div class="formulario-input">
                        <label>Observaciones</label>
                        <textarea id="txtObservaciones" class="form-control" rows="4"
                                  placeholder="Escriba las observaciones aquí..."></textarea>

                        <div class="row mb-3 mt-3">
                            <div class="col-md-5">
                                <div class="formulario-input">
                                    <label>Subir Documento SIAF</label>
                                    <input type="file" id="inputSiaf" name="DocSiaf" multiple class="input-file-rosa" />
                                </div>
                            </div>
                            <div class="col-md-5">
                                <div class="formulario-input">
                                    <label>Tabla de API</label>

                                    <!-- Botón para descargar la Tabla API pre-llenada desde el sistema -->
                                    <button type="button"
                                            class="btn boton-rosa mb-2 w-100"
                                            id="btnDescargarTablaApi"
                                            onclick="descargarTablaApi()"
                                            title="Genera el formato pre-llenado con los datos de la requisición">
                                        <i class="fa-solid fa-file-arrow-down"></i>
                                        Descargar Tabla API
                                    </button>

                                    <!-- Input para subir la Tabla API ya firmada (flujo original) -->
                                    <input type="file"
                                           id="inputTablaApi"
                                           name="TablaApi"
                                           multiple
                                           class="input-file-rosa" />
                                    <small class="text-muted" style="font-size:11px;">
                                        Descarga, firma y luego sube el archivo aquí
                                    </small>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="formulario-input">
                                    <label>Nº API</label>
                                    <input type="text" id="inputNumeroApi" class="form-control"
                                           placeholder="API-000" maxlength="20" />
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="botonesAtender" style="margin-top:20px; text-align:right; display:none;">
                        <button type="button" class="btn btn-danger me-2" onclick="rechazarDesdeAtencion()">
                            <i class="fa-solid fa-circle-xmark"></i> Rechazar
                        </button>
                        <button type="button" class="btn boton-rosa" onclick="enviarAtencion()">
                            <i class="fa-solid fa-check"></i> Autorizar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

