@using Inventario.AplicacionWeb.Models.ViewModels
@using Inventario.AplicacionWeb.Utilidades
@model VMTablaRequisiciones
@{
    ViewData["Title"] = "Presupuesto";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/tabla-requisiciones.css" asp-append-version="true" />
}

<div class="tabla-requi-page"
     data-url-notif-snapshot="@Url.Action("SnapshotIdsPorTab", "Financieros")"
     data-url-obtener-detalles="@Url.Action("ObtenerDetalles", "Requisicion")"
      data-url-usuarios-financieros="@Url.Action("ObtenerUsuariosFinancieros", "Financieros")"
     data-url-asignar=" @Url.Action("AsignarRequisicion", "Financieros")"
     data-url-atender="@Url.Action("Atender", "Financieros")"
     data-url-rechazar="@Url.Action("RechazarRequisicion", "Requisicion")"
     data-url-obtener-progreso="@Url.Action("ObtenerProgresoRequisicion", "Requisicion")"
     data-url-finalizar-expediente="@Url.Action("FinalizarRequisicion", "Financieros")"
      data-url-obtener-docs-proveedor="@Url.Action("ObtenerDocumentosProveedor", "Requisicion")"
     data-url-obtener-id-adquisicion="@Url.Action("ObtenerIdAdquisicion", "Requisicion")"
     data-url-rebotar-documentos="@Url.Action("RebotarDocumentos", "Financieros")"
     data-url-descargar-tabla-api="@Url.Action("DescargarTablaApi", "Financieros")"
     data-url-editar-tabla-api="@Url.Action("EditarTablaApi", "Financieros")"
     
     data-url-obtener-cotizaciones="@Url.Action("ObtenerCotizaciones", "Requisicion")"
      data-url-obtener-archivos="@Url.Action("ObtenerRequisicionesConArchivos", "Financieros")"
      data-url-consolidadas-documentos="@Url.Action("ObtenerConsolidadasConArchivos", "Financieros")"
     data-url-obtener-todos-archivos="@Url.Action("ObtenerTodosLosArchivos", "Financieros")"
     data-url-descargar-todos-archivos-zip="@Url.Action("DescargarTodosLosArchivosZip", "Requisicion")"
     data-url-consolidadas="@Url.Action("ObtenerConsolidadasFinancieros", "Financieros")"
     data-url-consolidadas-autorizadas="@Url.Action("ObtenerConsolidadasAutorizadasFinancieros", "Financieros")"
     data-url-asignar-consolidada="@Url.Action("AsignarConsolidada", "Financieros")"
     data-url-detalle-consolidada="@Url.Action("ObtenerDetalleConsolidadaFinancieros", "Financieros")"
     data-url-editar-tabla-api-consolidada="@Url.Action("EditarTablaApiConsolidada", "Financieros")"
     
     data-url-descargar-tabla-api-consolidada="@Url.Action("DescargarTablaApiConsolidada", "Financieros")"
     data-url-atender-consolidada="@Url.Action("AtenderConsolidada", "Financieros")"
     data-url-proceso-pago="@Url.Action("ObtenerProcesoPago", "Financieros")"
      data-url-expediente-consolidada="@Url.Action("ObtenerExpedienteConsolidada", "Consolidada")"
      data-url-obtener-archivos-consolidada="@Url.Action("ObtenerArchivosConsolidada", "Consolidada")"
      data-url-descargar-archivos-consolidada-zip="@Url.Action("DescargarArchivosConsolidadaZip", "Consolidada")"
data-url-historial-api="@Url.Action("HistorialTablaApi", "Financieros")"
       data-es-rol8="@(User.IsInRole("8") ? "true" : "false")"
      data-es-rol9="@(User.IsInRole("9") ? "true" : "false")"
      data-url-tiene-dual-gastos-pagar="@Url.Action("ObtenerTieneDualGastosPagar", "Financieros")"
      data-url-tiene-dual-gastos-pagar-consolidada="@Url.Action("ObtenerTieneDualGastosPagarConsolidada", "Financieros")">
    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Requisiciones </h1>
            <p class="tabla-requi-subtitulo">Gestión y seguimiento de requisiciones</p>
        </div>
    </div>

    <div class="container-formulario filtros-container">
        <div class="filtro-grupo">
            <label>No. Requisición</label>
            <input type="text" id="filtroNumReq" placeholder="REC-000000" />
        </div>
        <div class="filtro-grupo">
            <label>Fecha</label>
            <div style="display:flex; align-items:center; gap:6px;">
                <input type="text" id="filtroFecha" placeholder="Seleccionar fecha" readonly style="width:100%;" />
                <button type="button" id="btnLimpiarFecha"
                        style="display:none; background:none; border:none; cursor:pointer; color:#888; font-size:14px;"
                        title="Limpiar fecha" onclick="limpiarFecha()">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
        </div>
        <div class="filtro-grupo">
            <label>Departamento</label>
            <input type="text" id="filtroDepartamento" placeholder="Buscar departamento..." />
        </div>
        <div class="filtro-grupo">
            <label>Estado</label>
            <select id="filtroEstado" class="filtro-select-almacen">
                <option value="">Todos los estados</option>
                @foreach (var e in Model.Estatus)
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
    </div>

    <nav class="almacen-tabs">
        <button type="button" class="almacen-tabs-btn activo" data-tab="principal">En seguimiento</button>
        <button type="button" class="almacen-tabs-btn" data-tab="consolidadas">Consolidadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="procesopago">En proceso de pago</button>
        <button type="button" class="almacen-tabs-btn" data-tab="autorizadas">Requisiciones autorizadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="rechazadas">Requisiciones rechazadas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="documentos">Requisiciones con documentos</button>
    </nav>

    @{
        var numColsReq = 8;
        if (User.IsInRole("8")) numColsReq++;
        if (User.IsInRole("9") || User.IsInRole("8")) numColsReq++;
        var requisicionesPrincipal = Model.Requisiciones.ToList();
        var requisicionesAutorizadas = Model.Requisiciones.Where(r => r.IdEstatus == 15 || r.IdEstatus == 7 || r.IdEstatus == 12).ToList();
        var requisicionesRechazadas = Model.Requisiciones.Where(r => r.IdEstatus == 5).ToList();
        var requisicionesProcesoPago = Model.Requisiciones.Where(r => r.IdEstatus == 17).ToList();
    }

    <!-- Pestaña En seguimiento -->
    <div id="tab-principal" class="almacen-tab-panel activo">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesPrincipal">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Analista</th>
                        <th style="text-align:center">Partida(s)</th>
                        <th>Estado</th>
                        @if (User.IsInRole("8"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("9") || User.IsInRole("8"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxPrincipal = 0;
                    }
                    @foreach (var item in requisicionesPrincipal)
                    {
                        idxPrincipal++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi" data-requi-servicio="@(item.RequiServicio?.ToString().ToLower() ?? "false")">
                            <td style="text-align:center">@idxPrincipal</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerFolio(item.NumRequi))</td>
                            <td>@item.FechaEmision</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Departamento, "fa-solid fa-building"))</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Responsable, "fa-solid fa-user"))</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("8"))
                            {
                                <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.NombreAsignado ?? "Sin asignar", "fa-solid fa-clipboard-user"))</td>
                            }
                            @if (User.IsInRole("9") || User.IsInRole("8"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorP = item.DiasAsignado <= 3 ? "badge-semaforo-verde" : (item.DiasAsignado <= 5 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorP">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <div class="acciones-grupo" style="justify-content:center">
                                        <button class="btn-accion btn-ver" title="Ver detalle"
                                                onclick="verDetalle(@item.IdRequi, 'readonly')">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>
                                        @if (User.IsInRole("8") && item.IdEstatus == 13)
                                        {
                                            <button class="btn-accion" title="Asignar Requisición" onclick="abrirModalAsignar(@item.IdRequi)">
                                                <i class="fa-solid fa-clipboard-user"></i>
                                            </button>
                                        }
                                        @if (User.IsInRole("9") && item.IdEstatus == 14)
                                        {
                                            <button class="btn-accion" title="Atender" onclick="atenderRequisicion(@item.IdRequi)">
                                                <i class="fa-solid fa-hand-holding"></i>
                                            </button>
                                        }
                                        <a class="btn btn-accion"
                                               href="@Url.Action("HistorialTablaApi", "Financieros", new { idRequisicion = item.IdRequi })"
                                               title="Ver histórico Tabla API">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (fase, esTerminal, esMod, progress) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progress)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisici&oacute;n Capturada</strong>
                                                <span>Emisi&oacute;n @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotizaci&oacute;n</div>
                                            <div class="step-tooltip">
                                                <strong>Cotizaci&oacute;n / Presupuesto</strong>
                                                <span>@(fase >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 3 ? (esMod ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esMod ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@Html.Raw(esMod ? "A Modificar" : "Tr&aacute;mite")</div>
                                            <div class="step-tooltip">
                                                <strong>@Html.Raw(esMod ? "Modificaci&oacute;n" : "Tr&aacute;mite Operativo")</strong>
                                                <span>@(esMod ? "Regresada para cambios" : (fase >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(fase >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(fase >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(fase >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesPrincipal.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones en seguimiento</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones autorizadas -->
    <div id="tab-autorizadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesAutorizadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th>Partida(s)</th>
                        <th>Estado</th>
                        @if (User.IsInRole("8"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("9") || User.IsInRole("8"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyAutorizadasIndividuales">
                    @{
                        var idxAutorizadas = 0;
                    }
                    @foreach (var item in requisicionesAutorizadas)
                    {
                        idxAutorizadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi" data-requi-servicio="@(item.RequiServicio?.ToString().ToLower() ?? "false")">
                            <td style="text-align:center">@idxAutorizadas</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerFolio(item.NumRequi))</td>
                            <td>@item.FechaEmision</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Departamento, "fa-solid fa-building"))</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Responsable, "fa-solid fa-user"))</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("8"))
                            {
                                <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.NombreAsignado ?? "Sin asignar", "fa-solid fa-clipboard-user"))</td>
                            }
                            @if (User.IsInRole("9") || User.IsInRole("8"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorA = item.DiasAsignado <= 3 ? "badge-semaforo-verde" : (item.DiasAsignado <= 6 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorA">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi, 'readonly')">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                    <a class="btn btn-accion"
                                           href="@Url.Action("HistorialTablaApi", "Financieros", new { idRequisicion = item.IdRequi })"
                                           title="Ver histórico Tabla API">
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    @{
                                        var (faseA, esTerminalA, esModA, progA) = TimelineHelper.Calcular(item.IdEstatus);
                                    }
                                    <ul class="timeline-track" style="--progress: @(progA)%;">
                                        <li class="timeline-step completed">
                                            <div class="step-icon"><i class="fa-solid fa-file-signature"></i></div>
                                            <div class="step-label">Capturada</div>
                                            <div class="step-tooltip">
                                                <strong>Requisici&oacute;n Capturada</strong>
                                                <span>Emisi&oacute;n @item.FechaEmision</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 2 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-search-dollar"></i></div>
                                            <div class="step-label">Cotizaci&oacute;n</div>
                                            <div class="step-tooltip">
                                                <strong>Cotizaci&oacute;n / Presupuesto</strong>
                                                <span>@(faseA >= 2 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 3 ? (esModA ? "warning" : "completed") : "")">
                                            <div class="step-icon"><i class="fa-solid @(esModA ? "fa-rotate-left" : "fa-spinner")"></i></div>
                                            <div class="step-label">@Html.Raw(esModA ? "A Modificar" : "Tr&aacute;mite")</div>
                                            <div class="step-tooltip">
                                                <strong>@Html.Raw(esModA ? "Modificaci&oacute;n" : "Tr&aacute;mite Operativo")</strong>
                                                <span>@(esModA ? "Regresada para cambios" : (faseA >= 3 ? item.Estatus : "Pendiente"))</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 4 ? "completed" : "")">
                                            <div class="step-icon"><i class="fa-solid fa-user-tie"></i></div>
                                            <div class="step-label">Autorización</div>
                                            <div class="step-tooltip">
                                                <strong>Autorización Documental</strong>
                                                <span>@(faseA >= 4 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                        <li class="timeline-step @(faseA >= 5 ? "completed" : "")">
                                            <button type="button" class="btn-historial-timeline" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                                <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                            </button>
                                            <div class="step-icon"><i class="fa-solid fa-check-double"></i></div>
                                            <div class="step-label">Cierre</div>
                                            <div class="step-tooltip">
                                                <strong>Entregado / Finalizado</strong>
                                                <span>@(faseA >= 5 ? item.Estatus : "Pendiente")</span>
                                            </div>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesAutorizadas.Any())
                    {
                        <tr class="fila-vacia" id="filaVaciaAutorizadas">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones autorizadas</td>
                        </tr>
                    }
                </tbody>
                <!-- Consolidadas autorizadas (cargado dinamicamente) -->
                <tbody id="tbodyAutorizadasConsolidadas"></tbody>
            </table>
            <div id="paginacionAutorizadas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Pestaña Requisiciones rechazadas -->
    <div id="tab-rechazadas" class="almacen-tab-panel">
        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisicionesRechazadas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha de emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th>Partida(s)</th>
                        <th>Estado</th>
                        @if (User.IsInRole("8"))
                        {
                            <th>Asignado</th>
                        }
                        @if (User.IsInRole("9") || User.IsInRole("8"))
                        {
                            <th>Estatus</th>
                        }
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxRechazadas = 0;
                    }
                    @foreach (var item in requisicionesRechazadas)
                    {
                        idxRechazadas++;
                        <tr class="fila-requi" data-requi-id="@item.IdRequi" data-requi-servicio="@(item.RequiServicio?.ToString().ToLower() ?? "false")">
                            <td style="text-align:center">@idxRechazadas</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerFolio(item.NumRequi))</td>
                            <td>@item.FechaEmision</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Departamento, "fa-solid fa-building"))</td>
                            <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.Responsable, "fa-solid fa-user"))</td>
                            <td style="text-align:center">@item.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(item.IdEstatus, item.Estatus))</td>
                            @if (User.IsInRole("8"))
                            {
                                <td>@Html.Raw(TablaCampoHelper.ObtenerCampoConIcono(item.NombreAsignado ?? "Sin asignar", "fa-solid fa-clipboard-user"))</td>
                            }
                            @if (User.IsInRole("9") || User.IsInRole("8"))
                            {
                                <td>
                                    @if (item.DiasAsignado > 0 || item.NombreAsignado != null)
                                    {
                                        var claseColorR = item.DiasAsignado <= 3 ? "badge-semaforo-verde" : (item.DiasAsignado <= 6 ? "badge-semaforo-amarillo" : "badge-semaforo-rojo");
                                        <span class="badge-semaforo-premium @claseColorR">
                                            <i class="fa-solid fa-circle"></i>
                                            <span>@(item.DiasAsignado == 0 ? "Hoy" : item.DiasAsignado + (item.DiasAsignado == 1 ? " día" : " días"))</span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted" style="font-size: 11px; font-style: italic;">Sin asignación</span>
                                    }
                                </td>
                            }
                            <td>
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button class="btn-accion btn-ver" title="Ver detalle" onclick="verDetalle(@item.IdRequi)">
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr class="fila-detalle collapsed" data-requi-id="@item.IdRequi">
                            <td colspan="@numColsReq">
                                <div class="timeline-container">
                                    <div class="p-3 text-center" style="border:1px solid #fecaca;border-radius:10px;background:#fef2f2;">
                                        <p class="mb-1" style="color:#b91c1c;font-weight:700;"><i class="fa-solid fa-circle-xmark"></i> Requisición rechazada</p>
                                        <p class="text-muted small mb-2">El folio ya no está en seguimiento activo.</p>
                                        <button type="button" class="btn btn-sm" style="border:1px solid #fecaca;background:white;color:#b91c1c;" onclick="event.stopPropagation(); verHistorialTimeline(@item.IdRequi, '@item.NumRequi')">
                                            <i class="fa-solid fa-clock-rotate-left"></i> Ver historial
                                        </button>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!requisicionesRechazadas.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="@numColsReq" class="text-center">No hay requisiciones rechazadas</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRechazadas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- Tab proceso de pago -->
    <div id="tab-procesopago" class="almacen-tab-panel">
