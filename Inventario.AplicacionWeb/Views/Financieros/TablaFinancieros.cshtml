                </div>

                <div id="expFinArchivosBase" style="margin-top:16px;"></div>

                <div style="margin-top:16px;">
                    <div class="formulario-input">
                        <label>Observaciones de financieros</label>
                        <textarea id="expFinObservaciones" class="form-control" rows="3"
