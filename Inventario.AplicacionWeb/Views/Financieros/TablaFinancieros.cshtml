                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- Sección selects (siempre readonly aquí, se habilitan solo en atender) -->
            <div style="display:none; margin-top:20px;" class="px-4 seccionAtender">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Actividad:</label>
                            <select id="actividadSeleccionada" class="rosa-select-form">
                                <option value="">-- Selecciona actividad --</option>
                                @foreach (var act in Model.ListaActividades)
                                {
                                    <option value="@act.Value">@act.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Fuente de Financiamiento:</label>
                            <select id="ffSelect" class="rosa-select-form">
                                <option value="">-- Selecciona Fuente de Financiamiento --</option>
                                @foreach (var ff in Model.ListaFuentesFinanciamiento)
                                {
                                    <option value="@ff.Value">@ff.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="formulario-input">
                            <label>Tipo de Programa:</label>
                            <select id="tipoProgramaSelect" class="rosa-select-form">
                                <option value="">-- Selecciona el Tipo de Programa --</option>
                                <option value="1">Prioritario</option>
                                <option value="2">Adicional</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-body modal-body-premium">
                <div class="table-responsive-container">
                    <table class="tabla-requisiciones" id="tablaModalDetalle">
                        <thead>
                            <tr>
                                <th style="width:80px; display:none;" class="col-requi">Requisición</th>
                                <th style="width:120px;">No. de partida</th>
                                <th style="width:100px;">Cantidad</th>
                                <th style="width:135px;">Unidad Medida</th>
                                <th style="width:150px;">Descripción</th>
                                <th>Descripción Detallada</th>
                            </tr>
                        </thead>
                        <tbody id="tablaDetalle"></tbody>
                    </table>
                </div>

                <div id="seccionFotosDetalle" style="display:none; margin-top:16px;">
                    <hr />
                    <p style="font-weight:600; margin-bottom:8px;">
                        <i class="fa-solid fa-images"></i> Fotos de referencia
                    </p>
                    <div id="galeriaFotosDetalle" style="display:flex; flex-wrap:wrap; gap:10px;"></div>
                </div>

                <!-- Archivos subidos (readonly) -->
                <div id="contenedorArchivosReadonly"></div>

                <!-- Sección atender: botones de documentos + observaciones (solo rol 9) -->
                <div class="seccionAtender" style="display:none; margin-top:20px;">
                    <div class="formulario-input">
                        @if (User.IsInRole("9"))
                        {
                            <!-- Solo el analista (rol 9) puede subir archivos -->
                            <div class="row mb-3 seccionSubidaFinancieros">
                                <div class="col-md-5">
                                    <div class="formulario-input">
                                        <label>Subir Documento SIAF</label>
                                        <input type="file" id="inputSiaf" name="DocSiaf" multiple class="input-file-rosa" />
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="formulario-input">
                                        <label>Tabla de API</label>

                                        <button type="button"
                                                class="btn boton-gris mb-2 w-100"
                                                onclick="editarTablaApi()"
                                                title="Abre el editor visual de la Tabla API">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                            Editar Tabla API
                                        </button>

                                        <button type="button"
                                                class="btn boton-rosa mb-2 w-100"
                                                id="btnEditarApiConsolidada"
                                                style="display:none;"
                                                onclick="editarTablaApiConsolidada()"
                                                title="Abre el editor visual de la Tabla API para la consolidada">
                                            <i class="fa-solid fa-layer-group"></i>
                                            Editar Tabla API (Consolidada)
                                        </button>

                                        <!-- Input para subir la Tabla API ya firmada (flujo original) -->
                                        <input type="file"
                                               id="inputTablaApi"
                                               name="TablaApi"
                                               multiple
                                               class="input-file-rosa" />
                                        <small class="text-muted" style="font-size:11px;">
                                            Descarga, firma y luego sube el archivo aquí
                                        </small>
                                    </div>
                                </div>

                            </div>
                        }

                        <label>Observaciones</label>
                        <textarea id="txtObservaciones" class="form-control" rows="4"
                                  placeholder="Escriba las observaciones aquí..."></textarea>
                    </div>
                    <div id="botonesAtender" style="margin-top:20px; text-align:right; display:none;">
                        <button type="button" class="btn btn-danger me-2" onclick="rechazarDesdeAtencion()">
                            <i class="fa-solid fa-circle-xmark"></i> Rechazar
                        </button>
                        <button type="button" class="btn boton-rosa" onclick="enviarAtencion()">
                            <i class="fa-solid fa-check"></i> Autorizar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

