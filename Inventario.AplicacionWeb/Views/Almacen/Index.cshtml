@using Inventario.AplicacionWeb.Models.ViewModels
@using Inventario.AplicacionWeb.Utilidades
@model VMAlmacenIndex
@{
    ViewData["Title"] = "Almacen";
}

@section Styles {
    <link rel="stylesheet" href="~/css/almacen/almacen.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/tabla-requisiciones.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
}

<div class="tabla-requi-page"
     data-url-notif-snapshot="@Url.Action("SnapshotIdsPorTab", "Almacen")"
     data-url-obtener-requisicion="@Url.Action("ObtenerRequisicionCompleta", "Almacen")"
     data-url-ver-pdf="@Url.Action("VerSalidaParaPdf", "Almacen")"
     data-url-rechazar="@Url.Action("Rechazar", "Almacen")"
     data-url-registrar-ingreso="@Url.Action("RegistrarIngreso", "Almacen")"
     data-url-consultar-stock="@Url.Action("ConsultarStock", "Almacen")"
     data-url-procesar-requisicion="@Url.Action("ProcesarRequisicion", "Almacen")"
     data-url-confirmar-entrega="@Url.Action("ConfirmarEntrega", "Almacen")"
     data-url-obtener-partidas-compra="@Url.Action("ObtenerPartidasCompra", "Almacen")"
     data-url-guardar-borrador-ingreso="@Url.Action("GuardarBorradorIngreso", "Almacen")"
     data-url-confirmar-ingreso-pedido="@Url.Action("ConfirmarIngresoPedido", "Almacen")"
     data-url-documentos="@Url.Action("ObtenerDocumentos", "Almacen")">

    <div class="tabla-requi-header">
        <div>
            <h1 class="info-titulo">Departamento de Almacén</h1>
            <p class="tabla-requi-subtitulo">DIF Puebla · Sistema de Requisiciones</p>
        </div>
    </div>

    <nav class="almacen-tabs">
        <button type="button" class="almacen-tabs-btn activo" data-tab="requisiciones">Requisiciones Recibidas</button>
        <button type="button" class="almacen-tabs-btn" data-tab="entregas">A Entregar</button>
        <button type="button" class="almacen-tabs-btn" data-tab="pedidos">Pedidos</button>
        <button type="button" class="almacen-tabs-btn" data-tab="expedientes">Expedientes</button>
        <button type="button" class="almacen-tabs-btn" data-tab="inventario">Inventario</button>
    </nav>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Pestaña: Requisiciones Recibidas                            -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="tab-requisiciones" class="almacen-tab-panel activo">
        @{
            var enBandejaAlmacen = Model.Requisiciones.Count(r => r.IdEstatus == 9);
            var enCompraOEntrega = Model.Requisiciones.Count(r => r.IdEstatus == 11 || r.IdEstatus == 12);
            var autorizadas = Model.Requisiciones.Count(r => r.IdEstatus == 4 || r.IdEstatus == 10);
        }
        <div class="almacen-stats">
            <div class="stat-card">
                <div class="stat-numero">@enBandejaAlmacen</div>
                <div class="stat-label">En almacén (por analizar)</div>
            </div>
            <div class="stat-card">
                <div class="stat-numero">@Model.EntregasPendientes.Count</div>
                <div class="stat-label">Pendientes de entrega</div>
            </div>
            <div class="stat-card">
                <div class="stat-numero">@enCompraOEntrega</div>
                <div class="stat-label">Compra / entregado</div>
            </div>
            <div class="stat-card">
                <div class="stat-numero">@autorizadas</div>
                <div class="stat-label">Autorizadas</div>
            </div>
        </div>

        <div class="container-formulario filtros-container">
            <div class="filtro-grupo" style="flex:2;">
                <label>Buscar</label>
                <input type="text" id="filtroBuscar" placeholder="Buscar por folio, departamento o responsable..." />
            </div>
            <div class="filtro-grupo">
                <label>Estado</label>
                <select id="filtroEstado" class="filtro-select-almacen">
                    <option value="">Todos los estados</option>
                    @foreach (var e in Model.Estatus)
                    {
                        <option value="@e">@e</option>
                    }
                </select>
            </div>
        </div>

        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaRequisiciones">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha Emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th>Partida(s)</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idx = 0;
                    }
                    @foreach (var r in Model.Requisiciones.OrderBy(x => x.FechaEmision))
                    {
                        idx++;
                        <tr data-id="@r.IdRequi"
                            data-folio="@r.NumRequi"
                            data-depto="@(r.Departamento ?? "")"
                            data-estatus="@(r.Estatus ?? "")">
                            <td style="text-align:center">@idx</td>
                            <td><span class="folio-badge">@r.NumRequi</span></td>
                            <td>@r.FechaEmision?.ToString("dd/MM/yyyy")</td>
                            <td>@r.Departamento</td>
                            <td>@r.Responsable</td>
                            <td style="text-align:center">@r.CantidadPartidas</td>
                            <td>@Html.Raw(EstatusBadgeHelper.ObtenerBadge(r.IdEstatus, r.Estatus))</td>
                            <td>
                                <div class="acciones-grupo">
                                    <button type="button" class="btn-accion btn-ver" title="Analizar"
                                            data-id="@r.IdRequi"
                                            data-folio="@(r.NumRequi ?? "")"
                                            data-depto="@(r.Departamento ?? "")"
                                            data-estatus="@(r.Estatus ?? "")"
                                            data-almacen-analizar>
                                        <i class="fa-solid fa-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Requisiciones.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="8" class="text-center">No hay requisiciones</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionRequisiciones" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Pestaña: A Entregar                                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="tab-entregas" class="almacen-tab-panel">

        <div class="container-formulario filtros-container">
            <div class="filtro-grupo" style="flex:2;">
                <label>Buscar</label>
                <input type="text" id="filtroBuscarEntregas" placeholder="Buscar por folio o departamento..." />
            </div>
        </div>

        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaEntregas">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha Emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Artículos</th>
                        <th style="text-align:center">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxE = 0;
                    }
                    @foreach (var e in Model.EntregasPendientes)
                    {
                        idxE++;
                        <tr data-requi="@e.IdRequisicion"
                            data-folio="@e.NumRequi"
                            data-depto="@(e.Departamento ?? "")">
                            <td style="text-align:center">@idxE</td>
                            <td><span class="folio-badge">@e.NumRequi</span></td>
                            <td>@e.FechaEmision?.ToString("dd/MM/yyyy")</td>
                            <td>@e.Departamento</td>
                            <td>@e.Responsable</td>
                            <td style="text-align:center">@e.Articulos.Count</td>
                            <td style="text-align:center">
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button type="button" class="btn-accion btn-ver" title="Formato de salida (PDF)"
                                            data-entrega-id="@e.IdRequisicion"
                                            data-ver-pdf-salida>
                                        <i class="fa-solid fa-file-pdf"></i>
                                    </button>
                                    <button type="button" class="btn-accion btn-ver" title="Ver artículos a entregar"
                                            data-entrega-id="@e.IdRequisicion"
                                            data-entrega-folio="@e.NumRequi"
                                            data-entrega-depto="@e.Departamento"
                                            data-abrir-entrega>
                                        <i class="fa-solid fa-truck-ramp-box"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.EntregasPendientes.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="7" class="text-center">No hay artículos pendientes de entrega</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionEntregas" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Pestaña: Pedidos (Estatus 7 — Finalizado / En trámite)     -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="tab-pedidos" class="almacen-tab-panel">
        @{
            var totalPedidos = Model.Pedidos.Count;
        }
        <div class="almacen-stats">
            <div class="stat-card">
                <div class="stat-numero">@totalPedidos</div>
                <div class="stat-label">Pedidos pendientes de ingreso</div>
            </div>
        </div>

        <div class="container-formulario filtros-container">
            <div class="filtro-grupo" style="flex:2;">
                <label>Buscar</label>
                <input type="text" id="filtroBuscarPedidos" placeholder="Buscar por folio, departamento o responsable..." />
            </div>
        </div>

        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaPedidos">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha Emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Partida(s)</th>
                        <th style="text-align:center">Formato de Entrada</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idxP = 0;
                    }
                    @foreach (var p in Model.Pedidos)
                    {
                        idxP++;
                        <tr data-id="@p.IdRequi" data-folio="@(p.NumRequi ?? "")" data-depto="@(p.Departamento ?? "")">
                            <td style="text-align:center">@idxP</td>
                            <td><span class="folio-badge">@p.NumRequi</span></td>
                            <td>@p.FechaEmision?.ToString("dd/MM/yyyy")</td>
                            <td>@p.Departamento</td>
                            <td>@p.Responsable</td>
                            <td style="text-align:center">@p.CantidadPartidas</td>
                            <td style="text-align:center">
                                <div class="acciones-grupo" style="justify-content:center">
                                    @* <a href="@Url.Action("FormatoEntradaPdf", "Almacen", new { id = p.IdRequi })"
                                       target="_blank"
                                       class="btn-accion btn-ver"
                                       title="Ver Formato de Entrada">
                                        <i class="fa-solid fa-file-arrow-down"></i>
                                    </a> *@
                                    <button type="button"
                                            class="btn-accion btn-ver"
                                            title="Registrar ingreso de material"
                                            data-id="@p.IdRequi"
                                            data-folio="@(p.NumRequi ?? "")"
                                            data-depto="@(p.Departamento ?? "")"
                                            data-abrir-ingreso-pedido>
                                        <i class="fa-solid fa-truck-arrow-right"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Pedidos.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="7" class="text-center">No hay pedidos en trámite de pago</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionPedidos" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Pestaña: Expedientes                                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="tab-expedientes" class="almacen-tab-panel">
        <div class="almacen-stats">
            <div class="stat-card">
                <div class="stat-numero">@Model.RequisicionesConDocumentos.Count</div>
                <div class="stat-label">Requisiciones con documentación</div>
            </div>
        </div>

        <div class="container-formulario filtros-container">
            <div class="filtro-grupo" style="flex:2;">
                <label>Buscar en expedientes</label>
                <input type="text" id="filtroBuscarExpedientes" placeholder="Buscar por folio, depto o responsable..." />
            </div>
        </div>

        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaExpedientes">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Folio</th>
                        <th>Fecha Emisión</th>
                        <th>Departamento</th>
                        <th>Responsable</th>
                        <th style="text-align:center">Partidas</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{ var idxExp = 0; }
                    @foreach (var e in Model.RequisicionesConDocumentos)
                    {
                        idxExp++;
                        <tr>
                            <td style="text-align:center">@idxExp</td>
                            <td><span class="folio-badge">@e.NumRequi</span></td>
                            <td>@e.FechaEmision?.ToString("dd/MM/yyyy")</td>
                            <td>@e.Departamento</td>
                            <td>@e.Responsable</td>
                            <td style="text-align:center">@e.CantidadPartidas</td>
                            <td style="text-align:center">
                                <div class="acciones-grupo" style="justify-content:center">
                                    <button type="button"
                                            class="btn-accion btn-ver btn-ver-expediente"
                                            title="Ver Documentación"
                                            data-id="@e.IdRequi"
                                            data-folio="@(e.NumRequi ?? "")">
                                        <i class="fa-solid fa-folder-open"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.RequisicionesConDocumentos.Any())
                    {
                        <tr class="fila-vacia">
                            <td colspan="7" class="text-center">No hay requisiciones con documentación registrada</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="paginacionExpedientes" class="almacen-paginacion"></div>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- Pestaña: Inventario                                         -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <div id="tab-inventario" class="almacen-tab-panel">

        <div class="container-formulario filtros-container">
            <div class="filtro-grupo" style="flex:2;">
                <label>Buscar artículo</label>
                <input type="text" id="filtroBuscarInventario" placeholder="Buscar por descripción de material..." />
            </div>
            <div class="filtro-grupo filtro-grupo-unidad">
                <label>Unidad de medida</label>
                <select id="filtroUnidadMedida" class="filtro-select-almacen">
                    <option value="">Todas las unidades</option>
                    @foreach (var u in Model.UnidadesMedida)
                    {
                        <option value="@u">@u</option>
                    }
                </select>
            </div>
        </div>

        <div class="container-formulario tabla-container">
            <table class="tabla-requisiciones" id="tablaInventario">
                <thead>
                    <tr>
                        <th>Material</th>
                        <th>Unidad</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Situación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Model.Inventario)
                    {
                        var claseSituacion = i.Situacion == "Sin stock" ? "almacen-estado-sin-stock"
                        : i.Situacion == "Stock bajo" ? "almacen-estado-bajo"
                        : "almacen-estado-ok";
                        <tr data-unidad="@(i.UnidadMedida ?? "")">
                            <td>@i.Descripcion</td>
                            <td>@i.UnidadMedida</td>
                            <td class="@claseSituacion"><strong>@i.Existencia</strong></td>
                            <td>@i.Minimo</td>
                            <td class="@claseSituacion">@i.Situacion</td>
                        </tr>
                    }
                    <tr id="filaInventarioVacio" class="almacen-inv-empty" style="display:none;">
                        <td colspan="5" class="text-center">No hay registros de inventario</td>
                    </tr>
                </tbody>
            </table>
            <div id="paginacionInventario" class="almacen-paginacion"></div>
        </div>
    </div>

</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Modal análisis (Requisiciones Recibidas)                        -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal" id="modalAlmacen" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="modalAlmacenTitulo">—</h5>
                    <p class="modal-subtitulo-premium" id="modalAlmacenSubtitulo">Estado: —</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="almacen-modal-tabs">
                <button type="button" class="almacen-modal-tabs-btn activo" data-modal-tab="0">Verificación de Inventario</button>
                <button type="button" class="almacen-modal-tabs-btn" data-modal-tab="1">Detalles</button>
                <button type="button" class="almacen-modal-tabs-btn" data-modal-tab="2">Observaciones</button>
            </div>

            <div class="modal-body modal-body-premium" id="modalAlmacenBody">
                <p class="text-muted">Cargando...</p>
            </div>

            <div class="almacen-modal-footer">
                <button type="button" class="almacen-btn almacen-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Cerrar
                </button>
                <button type="button" class="almacen-btn almacen-btn-rechazar btn-almacen-rechazar">
                    <i class="fa-solid fa-ban"></i> Rechazar
                </button>
                <button type="button" class="almacen-btn almacen-btn-parcial btn-almacen-parcial">
                    <i class="fa-solid fa-list-check"></i> Procesar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Modal entrega física                                            -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal" id="modalEntrega" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="modalEntregaTitulo">Entrega de Materiales</h5>
                    <p class="modal-subtitulo-premium" id="modalEntregaSubtitulo">Confirma los artículos entregados</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" aria-label="Cerrar">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body modal-body-premium">
                <p style="font-size:13px; color:var(--color-text-secondary,#888); margin-bottom:12px;">
                    Marca los artículos que estás entregando físicamente al departamento solicitante.
                </p>
                <div class="formulario-input" style="margin-bottom:12px;">
                    <label for="inputFormatoSalidaFirmado">Subir formato de salida firmado (PDF)</label>
                    <input type="file"
                           id="inputFormatoSalidaFirmado"
                           accept=".pdf,application/pdf"
                           class="input-file-rosa" />
                    <small id="formatoSalidaFirmadoEstado" class="text-muted" style="font-size:11px;">
                        Sube el formato firmado para habilitar la confirmación de entrega.
                    </small>
                </div>
                <div class="table-responsive-container">
                    <table class="tabla-requisiciones" id="tablaModalEntrega">
                        <thead>
                            <tr>
                                <th style="width:40px;">
                                    <input type="checkbox" id="chkEntregaTodos" title="Seleccionar todos"
                                           style="width:16px;height:16px;cursor:pointer;" />
                                </th>
                                <th>Material</th>
                                <th style="text-align:center">Cantidad</th>
                                <th>Unidad</th>
                            </tr>
                        </thead>
                        <tbody id="tablaEntregaBody">
                            <tr>
                                <td colspan="4" class="text-center text-muted">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="almacen-modal-footer">
                <button type="button" class="almacen-btn almacen-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </button>
                <button type="button" class="almacen-btn almacen-btn-completa" id="btnConfirmarEntrega" disabled>
                    <i class="fa-solid fa-truck-ramp-box"></i> Confirmar Entrega
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Modal: Registrar Ingreso de Pedido                              -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal" id="modalIngresoPedido" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="modalIngresoPedidoTitulo">Registrar Ingreso</h5>
                    <p class="modal-subtitulo-premium" id="modalIngresoPedidoSubtitulo">Material recibido del proveedor</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body modal-body-premium">

                <!-- Paso 1 -->
                <div class="almacen-paso-indicator" style="margin-bottom:16px;">
                    <span class="almacen-paso activo" id="pasoIndicador1">
                        <i class="fa-solid fa-1"></i> Captura cantidades
                    </span>
                    <span class="almacen-paso" id="pasoIndicador2">
                        <i class="fa-solid fa-2"></i> Imprime y firma
                    </span>
                    <span class="almacen-paso" id="pasoIndicador3">
                        <i class="fa-solid fa-3"></i> Sube firmado
                    </span>
                </div>

                <div class="table-responsive-container" style="margin-bottom:16px;">
                    <table class="tabla-requisiciones" id="tablaModalIngresoPedido">
                        <thead>
                            <tr>
                                <th>Material</th>
                                <th>Unidad</th>
                                <th style="text-align:center">Solicitado</th>
                                <th style="text-align:center">Recibido</th>
                                <th style="text-align:center">Faltante</th>
                            </tr>
                        </thead>
                        <tbody id="tablaIngresoPedidoBody">
                            <tr><td colspan="5" class="text-center text-muted">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- Paso 2/3 -->
                <div class="formulario-input">
                    <label for="inputFormatoEntradaFirmado">
                        Subir formato de entrada firmado (PDF)
                    </label>
                    <input type="file" id="inputFormatoEntradaFirmado"
                           accept=".pdf,application/pdf" class="input-file-rosa" />
                    <small id="formatoEntradaFirmadoEstado" class="text-muted" style="font-size:11px;">
                        Primero guarda las cantidades para generar el formato.
                    </small>
                </div>

            </div>

            <div class="almacen-modal-footer">
                <button type="button" class="almacen-btn almacen-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Cancelar
                </button>
                <button type="button" class="almacen-btn almacen-btn-parcial" id="btnGuardarBorradorIngreso">
                    <i class="fa-solid fa-floppy-disk"></i> Guardar y generar formato
                </button>
                <button type="button" class="almacen-btn almacen-btn-completa"
                        id="btnConfirmarIngresoPedido" disabled>
                    <i class="fa-solid fa-truck-arrow-right"></i> Confirmar ingreso
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Panel descripción detallada -->
<div id="desc-panel-modal" style="display:none;">
    <div class="desc-panel-modal-header">
        <span class="desc-panel-modal-titulo">Descripción detallada</span>
        <button type="button" class="desc-panel-modal-cerrar" onclick="cerrarDescPanelModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <textarea id="desc-textarea-modal" class="desc-textarea" readonly rows="5"></textarea>
</div>

<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Modal: Expediente de Documentación                              -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal" id="modalExpediente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-premium">
            <div class="modal-header modal-header-premium">
                <div>
                    <h5 class="modal-title modal-titulo-premium" id="modalExpedienteTitulo">Expediente Digital</h5>
                    <p class="modal-subtitulo-premium" id="modalExpedienteSubtitulo">Documentos vinculados a la requisición</p>
                </div>
                <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="modal-body modal-body-premium">
                <div class="table-responsive-container">
                    <table class="tabla-requisiciones tabla-expedientes-compacta" id="tablaModalExpediente">
                        <thead>
                            <tr>
                                <th>Documento</th>
                                <th>Tipo</th>
                                <th>Fecha</th>
                                <th style="width:50px;"></th>
                            </tr>
                        </thead>
                        <tbody id="tablaExpedienteBody">
                            <tr><td colspan="4" class="text-center text-muted">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="almacen-modal-footer">
                <button type="button" class="almacen-btn almacen-btn-cerrar" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>


<!-- ═══════════════════════════════════════════════════════════════ -->
<!-- Modal: Visor de Documentos (Preview)                            -->
<!-- ═══════════════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalVisor" tabindex="-1" aria-hidden="true" style="z-index: 1070;">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content modal-premium" style="height: 90vh; border-radius: 12px; overflow: hidden;">
            <div class="modal-header modal-header-premium" style="padding: 12px 24px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <div style="width: 32px; height: 32px; background: rgba(255,255,255,0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>
                    <div>
                        <h5 class="modal-title modal-titulo-premium" id="visorTitulo" style="font-size: 16px; margin: 0;">Vista Previa</h5>
                        <p class="modal-subtitulo-premium" style="font-size: 11px; margin: 0; opacity: 0.8;">Visor de Expediente Digital</p>
                    </div>
                </div>
                <div style="display: flex; gap: 10px;">
                    <a id="btnDescargarVisor" href="#" target="_blank" class="btn btn-sm btn-light" style="border-radius: 6px; font-weight: 600; font-size: 12px; display: flex; align-items: center; gap: 6px; padding: 6px 12px;">
                        <i class="fa-solid fa-download"></i> Descargar
                    </a>
                    <button type="button" class="modal-btn-cerrar" data-bs-dismiss="modal" style="background: rgba(255,255,255,0.1); border: none; width: 32px; height: 32px; border-radius: 8px; color: white;">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
            </div>
            <div class="modal-body p-0" id="visorContent" style="background: #333; display: flex; align-items: center; justify-content: center; position: relative; height: calc(90vh - 60px);">
                <div class="text-white text-center" id="visorCargando">
                    <div class="spinner-border text-light mb-2" role="status"></div>
                    <p style="font-size: 13px;">Cargando documento...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/es.js"></script>
    <script src="~/js/shared/tabs-notificaciones-requi.js" asp-append-version="true"></script>
    <script src="~/js/almacen/almacen.js" asp-append-version="true"></script>
}
