@model Inventario.AplicacionWeb.Models.ViewModels.VMRequiForm
@using System.Globalization
@{
    Layout = null;
    var fechaTexto = Model.FechaEmision?.ToString("dd/MM/yyyy", CultureInfo.InvariantCulture) ?? "—";
    var requisicion = Model.NumRequisicion ?? "—";
    var solicitante = Model.NomResponsableDepartamento ?? "—";
    var esDonativo = Model.UsoMaterial == true;
    var articulos = Model.Articulos ?? new List<Inventario.AplicacionWeb.Models.ViewModels.ItemRequiVM>();
    const string folioEstatico = "1000";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Salida de materiales @requisicion</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/formulario-requisiciones.css" asp-append-version="true" />
</head>
<body class="pdf-documento">
    <div class="pdf-wrapper">
        <div class="pdf-hoja-1">
            <div class="pdf-encabezado">
                <div class="pdf-encabezado-logo">
                    <img src="~/img/familias-dif-rosa.png" alt="Logo DIF" />
                </div>
                <div class="pdf-encabezado-texto">
                    <p>Sistema para el Desarrollo Integral de la Familia</p>
                    <p>del Estado de Puebla</p>
                    <p>Ave. Reforma No. 1305 Colonia Centro &nbsp;|&nbsp; Puebla, Pue., C.P. 72000</p>
                    <p>Dirección de Administración y Finanzas</p>
                    <p>Depto. de Recursos Materiales y Servicios Generales</p>
                    <p>Sección de Almacén e Inventarios</p>
                    <p class="pdf-encabezado-titulo">Salidas de materiales</p>
                </div>
                <div class="pdf-encabezado-cuadro">
                    <span class="pdf-requi-label">Folio</span>
                    <span class="pdf-requi-num pdf-folio-valor">@folioEstatico</span>
                </div>
            </div>

            <div class="pdf-seccion pdf-grid-2">
                <div class="pdf-campo">
                    <span class="pdf-campo-label">Recibo de donativos</span>
                    <span class="pdf-campo-valor">@(esDonativo ? "Sí" : "No")</span>
                </div>
                <div class="pdf-campo">
                    <span class="pdf-campo-label">Fecha</span>
                    <span class="pdf-campo-valor">@fechaTexto</span>
                </div>
                <div class="pdf-campo">
                    <span class="pdf-campo-label">Solicitante</span>
                    <span class="pdf-campo-valor">@solicitante</span>
                </div>
                <div class="pdf-campo">
                    <span class="pdf-campo-label">Pedido</span>
                    <span class="pdf-campo-valor">—</span>
                </div>
                <div class="pdf-campo">
                    <span class="pdf-campo-label">Entrada</span>
                    <span class="pdf-campo-valor">—</span>
                </div>
                <div class="pdf-campo">
                    <span class="pdf-campo-label">Requisición</span>
                    <span class="pdf-campo-valor">@requisicion</span>
                </div>
            </div>

            <div class="pdf-salida-cuerpo">
                <div class="pdf-seccion pdf-salida-tabla-wrap">
                    <table class="pdf-tabla pdf-tabla-salida">
                        <thead>
                            <tr>
                                <th>Clave</th>
                                <th>Cantidad</th>
                                <th>Unidad</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (articulos.Any())
                            {
                                @foreach (var item in articulos)
                                {
                                    string clave;
                                    if (item.ClaveMaterial.HasValue)
                                        clave = item.ClaveMaterial.Value.ToString(CultureInfo.InvariantCulture);
                                    else if (item.Cog.HasValue)
                                        clave = item.Cog.Value.ToString(CultureInfo.InvariantCulture);
                                    else if (item.IdArticulo.HasValue)
                                        clave = item.IdArticulo.Value.ToString(CultureInfo.InvariantCulture);
                                    else
                                        clave = "—";

                                    var cantidad = item.Cantidad.HasValue
                                        ? decimal.Truncate(item.Cantidad.Value) == item.Cantidad.Value
                                            ? ((int)item.Cantidad.Value).ToString(CultureInfo.InvariantCulture)
                                            : item.Cantidad.Value.ToString("0.##", CultureInfo.InvariantCulture)
                                        : string.Empty;
                                    <tr>
                                        <td>@clave</td>
                                        <td>@cantidad</td>
                                        <td>@(item.UnidadMedida ?? string.Empty)</td>
                                        <td>@(item.Descripcion ?? item.DescripcionDetallada ?? string.Empty)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="pdf-salida-vacio">Sin artículos pendientes de entrega</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pdf-seccion pdf-firmas pdf-firmas--salida">
                    <div class="pdf-firma-item">
                        <span class="pdf-firma-titulo-salida">Autorizo</span>
                        <div class="pdf-firma-linea" aria-hidden="true"></div>
                        <span class="pdf-firma-rol">Nombre y firma</span>
                    </div>
                    <div class="pdf-firma-item">
                        <span class="pdf-firma-titulo-salida">Entrego</span>
                        <div class="pdf-firma-linea" aria-hidden="true"></div>
                        <span class="pdf-firma-rol">Nombre y firma</span>
                    </div>
                    <div class="pdf-firma-item">
                        <span class="pdf-firma-titulo-salida">Recibió</span>
                        <div class="pdf-firma-linea" aria-hidden="true"></div>
                        <span class="pdf-firma-rol">Nombre y firma</span>
                    </div>
                </div>
            </div>

            <p class="pdf-salida-leyenda">Sección de almacén e inventarios</p>
        </div>

        <div class="pdf-imprimir no-print">
            <button type="button" onclick="window.print();">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                    <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z" />
                </svg>
                Imprimir / Guardar como PDF
            </button>
        </div>
    </div>
</body>
</html>
