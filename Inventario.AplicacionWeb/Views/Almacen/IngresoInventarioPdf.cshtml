@model Inventario.AplicacionWeb.Models.ViewModels.VMIngresoInventarioPdf
@using System.Globalization
@{
    Layout = null;
    var cultura   = CultureInfo.GetCultureInfo("es-MX");
    var fechaTexto = Model.Fecha.ToString("dd/MM/yyyy", cultura);
    var folioTexto = Model.Folio > 0 ? Model.Folio.ToString().PadLeft(4, '0') : "—";
    var articulos  = Model.Items ?? new List<Inventario.AplicacionWeb.Models.ViewModels.VMIngresoItemPdf>();
    var minFilas   = Math.Max(14, articulos.Count);
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ingreso de Inventario — Folio @folioTexto</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requisicion/formulario-requisiciones.css" asp-append-version="true" />
    <style>
        .pdf-entrada-campos {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 10px 20px;
            margin-bottom: 8px;
            box-shadow: 0 1px 3px rgba(0,0,0,.04);
        }

        .pdf-entrada-fila {
            display: flex;
            align-items: baseline;
            gap: 8px;
            border-bottom: 1px solid #f1f5f9;
            padding: 5px 0;
            font-size: 11px;
        }

        .pdf-entrada-fila:last-child { border-bottom: none; }

        .pdf-entrada-fila-multi {
            display: grid;
            gap: 0 16px;
            border-bottom: 1px solid #f1f5f9;
            padding: 5px 0;
        }

        .pdf-entrada-fila-multi:last-child { border-bottom: none; }

        .pdf-entrada-fila-multi .pdf-entrada-campo { display: flex; align-items: baseline; gap: 6px; }

        .pdf-entrada-campo { display: flex; align-items: baseline; gap: 6px; }

        .pdf-entrada-label {
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: #64748b;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .pdf-entrada-valor {
            font-size: 12px;
            font-weight: 500;
            color: #1a1a1a;
            border-bottom: 1px solid #cbd5e1;
            flex: 1;
            min-height: 18px;
            min-width: 60px;
        }

        .pdf-folio-valor {
            font-size: 22px !important;
            font-weight: 800 !important;
            color: #b91c1c !important;
            border-bottom: none !important;
            letter-spacing: 1px;
            line-height: 1.1;
        }

        .pdf-tabla-entrada tbody tr.fila-vacia td {
            height: 20px;
            padding: 2px 12px;
        }

        .pdf-entrada-leyenda {
            text-align: center;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #374151;
            margin-top: 10px;
            margin-bottom: 0;
        }

        .pdf-motivo-bloque {
            margin-top: 8px;
            padding: 8px 14px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            background: #f8fafc;
            font-size: 11px;
            color: #334155;
        }

        .pdf-motivo-bloque strong {
            display: block;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            color: #64748b;
            margin-bottom: 3px;
        }

        @@media print {
            .no-print { display: none !important; }
        }
    </style>
</head>
<body class="pdf-documento">
    <div class="pdf-wrapper">
        <div class="pdf-hoja-1">

            <!-- ENCABEZADO INSTITUCIONAL -->
            <div class="pdf-encabezado">
                <div class="pdf-encabezado-logo">
                    <img src="~/img/familias-dif-rosa.png" alt="Logo DIF Puebla" />
                </div>
                <div class="pdf-encabezado-texto">
                    <p>Unidad de Planeación, Administración y Finanzas</p>
                    <p>Departamento de Recursos Materiales y Servicios Generales</p>
                    <p>Almacén e Inventario</p>
                    <p class="pdf-encabezado-titulo">Ingreso de Inventario</p>
                </div>
                <div class="pdf-encabezado-cuadro">
                    <span class="pdf-requi-label">Folio</span>
                    <span class="pdf-requi-num pdf-folio-valor">@folioTexto</span>
                </div>
            </div>

            <!-- CAMPOS DE CABECERA -->
            <div class="pdf-entrada-campos">
                <div class="pdf-entrada-fila-multi" style="grid-template-columns: repeat(3,1fr);">
                    <div class="pdf-entrada-campo">
                        <span class="pdf-entrada-label">Fecha:</span>
                        <span class="pdf-entrada-valor">@fechaTexto</span>
                    </div>
                    <div class="pdf-entrada-campo">
                        <span class="pdf-entrada-label">Almacén:</span>
                        <span class="pdf-entrada-valor">Almacén General</span>
                    </div>
                    <div class="pdf-entrada-campo">
                        <span class="pdf-entrada-label">Tipo:</span>
                        <span class="pdf-entrada-valor">Ingreso Directo</span>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Motivo))
                {
                    <div class="pdf-entrada-fila">
                        <div class="pdf-entrada-campo" style="flex:1;">
                            <span class="pdf-entrada-label">Motivo:</span>
                            <span class="pdf-entrada-valor">@Model.Motivo</span>
                        </div>
                    </div>
                }
            </div>

            <!-- TABLA DE ARTÍCULOS -->
            <div class="pdf-salida-cuerpo">
                <div class="pdf-seccion pdf-salida-tabla-wrap">
                    <table class="pdf-tabla pdf-tabla-salida pdf-tabla-entrada">
                        <thead>
                            <tr>
                                <th>Clave</th>
                                <th>Cantidad</th>
                                <th>Unidad</th>
                                <th>Descripción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < minFilas; i++)
                            {
                                if (i < articulos.Count)
                                {
                                    var art = articulos[i];
                                    var cantTexto = art.Cantidad.ToString(CultureInfo.InvariantCulture);
                                    <tr>
                                        <td>@(art.Clave ?? "")</td>
                                        <td>@cantTexto</td>
                                        <td>@art.UnidadMedida</td>
                                        <td>@art.Descripcion</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="fila-vacia">
                                        <td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- FIRMAS -->
                <div class="pdf-seccion pdf-firmas pdf-firmas--salida">
                    <div class="pdf-firma-item">
                        <span class="pdf-firma-titulo-salida">Autorizo</span>
                        <div class="pdf-firma-linea" aria-hidden="true"></div>
                        <span class="pdf-firma-rol">Nombre y Firma</span>
                    </div>
                    <div class="pdf-firma-item">
                        <span class="pdf-firma-titulo-salida">Registró</span>
                        <div class="pdf-firma-linea" aria-hidden="true"></div>
                        <span class="pdf-firma-rol">Nombre y Firma</span>
                    </div>
                    <div class="pdf-firma-item">
                        <span class="pdf-firma-titulo-salida">Recibió</span>
                        <div class="pdf-firma-linea" aria-hidden="true"></div>
                        <span class="pdf-firma-rol">Nombre y Firma</span>
                    </div>
                </div>
            </div>

            <p class="pdf-entrada-leyenda">Sección de Almacén e Inventarios</p>

        </div>

        <!-- BOTÓN IMPRIMIR -->
        <div class="pdf-imprimir no-print">
            <button type="button" onclick="window.print();">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M2.5 8a.5.5 0 1 0 0-1 .5.5 0 0 0 0 1z" />
                    <path d="M5 1a2 2 0 0 0-2 2v2H2a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h1v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1h1a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-1V3a2 2 0 0 0-2-2H5zM4 3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2H4V3zm1 5a2 2 0 0 0-2 2v1H2a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v-1a2 2 0 0 0-2-2H5zm7 2v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1z" />
                </svg>
                Imprimir / Guardar como PDF
            </button>
        </div>

    </div>
</body>
</html>
